{
  "entities": {
    "substitution": {
      "title": "Substitution",
      "description": "School teacher substitution record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "day": { "type": "string", "maxLength": 32 },
        "period": { "type": "string", "maxLength": 32 },
        "gradeClass": { "type": "string", "maxLength": 64 },
        "absentTeacher": { "type": "string", "maxLength": 100 },
        "substituteTeacher": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["مؤكد", "قيد الانتظار", "تم الحضور", "ملغي"] },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "date", "day", "period", "gradeClass", "absentTeacher", "substituteTeacher", "subject", "status"]
    },
    "duty": {
      "title": "Duty",
      "description": "School supervisory duty item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "day": { "type": "string", "maxLength": 32 },
        "location": { "type": "string", "maxLength": 100 },
        "leadTeacher": { "type": "string", "maxLength": 100 },
        "assistants": { "type": "string", "maxLength": 200 },
        "timeSlot": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "day", "location", "leadTeacher"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "School ticker announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "urgent", "hadith", "event"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "text", "type", "active"]
    },
    "timetableItem": {
      "title": "TimetableItem",
      "description": "School class schedule lesson item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "day": { "type": "string", "maxLength": 32 },
        "periodId": { "type": "string", "maxLength": 32 },
        "gradeClass": { "type": "string", "maxLength": 64 },
        "subject": { "type": "string", "maxLength": 100 },
        "teacher": { "type": "string", "maxLength": 100 },
        "room": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "day", "periodId", "gradeClass", "subject", "teacher"]
    },
    "period": {
      "title": "Period",
      "description": "School bell schedule period definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 64 },
        "startTime": { "type": "string", "maxLength": 16 },
        "endTime": { "type": "string", "maxLength": 16 },
        "isBreak": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "startTime", "endTime", "isBreak", "order"]
    },
    "settings": {
      "title": "SchoolSettings",
      "description": "Global school signage settings",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 100 },
        "ministryBadge": { "type": "string", "maxLength": 500 },
        "gasUrl": { "type": "string", "maxLength": 500 },
        "autoRefreshIntervalSeconds": { "type": "number" },
        "playChimeOnPeriodChange": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark", "midnight", "emerald"] },
        "displayMode": { "type": "string", "enum": ["paging", "dense_grid", "continuous_scroll"] },
        "pagingIntervalSeconds": { "type": "number" },
        "itemsPerPage": { "type": "number" },
        "adminPin": { "type": "string", "maxLength": 32 }
      },
      "required": ["schoolName", "theme"]
    }
  },
  "firestore": {
    "/substitutions/{subId}": {
      "schema": "substitution",
      "description": "Daily teacher substitution assignments"
    },
    "/duties/{dutyId}": {
      "schema": "duty",
      "description": "Teacher supervisory and courtyard duties"
    },
    "/announcements/{annId}": {
      "schema": "announcement",
      "description": "School board announcements and tickers"
    },
    "/timetable/{itemId}": {
      "schema": "timetableItem",
      "description": "Weekly school master timetable schedule"
    },
    "/periods/{periodId}": {
      "schema": "period",
      "description": "School timetable periods and break configuration"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "System and school display preferences"
    }
  }
}
