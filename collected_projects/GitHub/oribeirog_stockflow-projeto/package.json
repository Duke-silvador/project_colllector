{
  "name": "mnr-perfumes",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo desktop local MNR Perfumes",
  "author": "MNR Software",
  "license": "UNLICENSED",
  "main": "dist/electron/main/index.js",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/preload.mjs",
    "build": "ng build && npm run build:electron",
    "postinstall": "node scripts/native.mjs",
    "pack": "npm run build && node scripts/package.mjs --dir",
    "dist": "npm run build && node scripts/package.mjs",
    "test": "npm run build && node --test tests/*.test.cjs && node scripts/smoke.mjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "better-sqlite3": "13.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "angular-eslint": "22.6.0",
    "electron": "43.8.6",
    "electron-builder": "26.18.1",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0"
  }
}
