{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "General configurations and page content for the educational institution website",
      "type": "object",
      "properties": {
        "institutionName": { "type": "string" },
        "shortName": { "type": "string" },
        "institutionBadge": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "experienceYears": { "type": "string" },
        "experienceLabel": { "type": "string" },
        "experienceSublabel": { "type": "string" },
        "aboutPrincipalAuthority": { "type": "string" },
        "aboutPrincipalRole": { "type": "string" },
        "aboutMission": { "type": "string" },
        "aboutVision": { "type": "string" },
        "aboutSlogan": { "type": "string" },
        "programBachillerato": { "type": "string" },
        "programSuperior": { "type": "string" },
        "programElemental": { "type": "string" },
        "programInicial": { "type": "string" },
        "contactAddress": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactSchedule": { "type": "string" },
        "enrollmentFormUrl": { "type": "string" },
        "continueFormUrl": { "type": "string" },
        "mapsEmbedQuery": { "type": "string" },
        "idukayUrl": { "type": "string" },
        "billsUrl": { "type": "string" },
        "facebookUrl": { "type": "string" }
      }
    },
    "News": {
      "title": "News",
      "description": "School news and announcements",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "School photos and gallery",
      "type": "object",
      "properties": {
        "src": { "type": "string" },
        "category": { "type": "string" },
        "showInIndex": { "type": "boolean" },
        "createdAt": { "type": "number" }
      }
    },
    "Event": {
      "title": "Event",
      "description": "Academic calendar events",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Teachers, directors and administrative staff",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "HelpdeskTicket": {
      "title": "HelpdeskTicket",
      "description": "Infrastructure, lab and systems maintenance incidents reported via QR",
      "type": "object",
      "properties": {
        "ticketCode": { "type": "string" },
        "assetId": { "type": "string" },
        "assetName": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reportedRole": { "type": "string" },
        "contactInfo": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "resolvedAt": { "type": "number" },
        "technicianNotes": { "type": "string" },
        "technicianName": { "type": "string" }
      }
    },
    "HelpdeskAsset": {
      "title": "HelpdeskAsset",
      "description": "School physical assets (computers, projectors, desks) with QR codes",
      "type": "object",
      "properties": {
        "assetCode": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "brandModel": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "HelpdeskMaterial": {
      "title": "HelpdeskMaterial",
      "description": "Custom material templates (mouse, keyboards, desks, etc.) dynamically assigned to school labs",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "prefixCode": { "type": "string" },
        "defaultQty": { "type": "number" },
        "assignedLabs": { "type": "array", "items": { "type": "string" } },
        "brandModel": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "HelpdeskSettings": {
      "title": "HelpdeskSettings",
      "description": "Custom configuration for the HelpDesk system (title, announcement banner, labs, technician info, quick issues)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "announcement": { "type": "string" },
        "laboratories": { "type": "array", "items": { "type": "string" } },
        "technicianName": { "type": "string" },
        "technicianPhone": { "type": "string" },
        "technicianEmail": { "type": "string" },
        "supportHours": { "type": "string" },
        "commonIssues": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "category": { "type": "string" }
            }
          } 
        },
        "isActive": { "type": "boolean" },
        "maintenanceNotice": { "type": "string" }
      }
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Authorized administrator accounts permitted to access the management portal with specific roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["email", "role", "status"]
    },
    "SecurityIncident": {
      "title": "SecurityIncident",
      "description": "Cybersecurity attack incidents, anomalies and lockdown event logs",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "threatLevel": { "type": "string" },
        "timestamp": { "type": "number" },
        "ipOrigin": { "type": "string" },
        "status": { "type": "string" },
        "resolvedBy": { "type": "string" }
      }
    },
    "Sorteo": {
      "title": "Sorteo",
      "description": "Institutional raffles, prize draws and giveaways",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "prizes": { "type": "array" },
        "drawDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "winnerTicketCode": { "type": "string" },
        "winnerParticipantName": { "type": "string" }
      },
      "required": ["title", "status"]
    },
    "SorteoTicket": {
      "title": "SorteoTicket",
      "description": "Tickets registered for institutional raffles with unique code and institutional verification QR",
      "type": "object",
      "properties": {
        "sorteoId": { "type": "string" },
        "ticketCode": { "type": "string" },
        "participantName": { "type": "string" },
        "participantPhone": { "type": "string" },
        "participantEmail": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["sorteoId", "ticketCode", "status"]
    }
  },
  "firestore": {
    "/sorteos/{sorteoId}": {
      "schema": "Sorteo",
      "description": "Institutional raffles and prize draws collection"
    },
    "/sorteo_tickets/{ticketId}": {
      "schema": "SorteoTicket",
      "description": "Raffle tickets with QR validation codes"
    },
    "/siteConfig/{configId}": {
      "schema": "SiteConfig",
      "description": "Stores global site settings such as hero, liveStream, securityLockdown, and pageContent"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "School news collection"
    },
    "/gallery/{imageId}": {
      "schema": "GalleryItem",
      "description": "Photo gallery collection"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "School calendar events collection"
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "School staff directory collection"
    },
    "/helpdesk_tickets/{ticketId}": {
      "schema": "HelpdeskTicket",
      "description": "Helpdesk infrastructure incidents reported via QR codes"
    },
    "/helpdesk_assets/{assetId}": {
      "schema": "HelpdeskAsset",
      "description": "Inventory of school assets with unique QR codes"
    },
    "/helpdesk_materials/{materialId}": {
      "schema": "HelpdeskMaterial",
      "description": "Custom material templates that administrators register, edit, and associate with laboratories"
    },
    "/helpdesk_settings/{settingId}": {
      "schema": "HelpdeskSettings",
      "description": "Customizable HelpDesk system settings, laboratories, common issues and technician info"
    },
    "/authorized_users/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Authorized administrator accounts permitted to access the management portal managed by the Super Admin"
    },
    "/security_incidents/{incidentId}": {
      "schema": "SecurityIncident",
      "description": "Security incident records and cyberattack mitigation history"
    }
  }
}
