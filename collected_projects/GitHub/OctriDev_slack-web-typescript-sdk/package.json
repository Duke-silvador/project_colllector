{
  "name": "octri-slack-web",
  "description": "One way to interact with the Slack platform is its HTTP RPC-based Web API, a collection of methods requiring OAuth 2.0-based user, bot, or workspace tokens blessed with related OAuth scopes.",
  "version": "1.7.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctriDev/slack-web-typescript-sdk.git"
  },
  "homepage": "https://github.com/OctriDev/slack-web-typescript-sdk",
  "bugs": {
    "url": "https://github.com/OctriDev/slack-web-typescript-sdk/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt --check src test/*.mjs",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.4.0"
  }
}
