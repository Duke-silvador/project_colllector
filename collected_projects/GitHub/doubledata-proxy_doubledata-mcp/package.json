{
  "name": "@doubledata/mcp",
  "version": "0.1.0",
  "description": "MCP server and agent skills for DoubleData Proxy: account, usage, credentials, invoices, ISP proxies, and requests through the proxy network.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "doubledata-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubledata-proxy/doubledata-mcp.git"
  },
  "homepage": "https://doubledata.mintlify.app/guides/ai-agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "residential-proxy",
    "agent-skills",
    "claude-code",
    "doubledata"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^7.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
