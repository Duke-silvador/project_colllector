{
  "name": "mru-docs",
  "private": true,
  "type": "module",
  "description": "Source for docs.mru.space",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/seo/postbuild.mjs && node scripts/seo/check.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "check:types": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs dist",
    "test:e2e": "playwright test",
    "check:lighthouse": "lhci autorun",
    "check": "npm run check:tokens && npm run check:types && npm run lint && npm run build && npm run check:html && npm run check:links && npm run test:e2e && npm run check:lighthouse"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "linkedom": "0.18.13",
    "linkinator": "8.1.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "satori": "0.44.3",
    "schema-dts": "2.1.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
