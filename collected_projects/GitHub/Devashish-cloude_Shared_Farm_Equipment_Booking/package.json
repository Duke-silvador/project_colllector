{
  "name": "shared-farm-root",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Farm Equipment Booking Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:all": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "concurrently": "^9.1.2"
  }
}
