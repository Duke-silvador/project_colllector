{
  "name": "waqtwise",
  "productName": "WaqtWise",
  "version": "1.1.0",
  "description": "WaqtWise - a daily planner that divides your day into five zones by the prayer times (Windows)",
  "private": true,
  "author": "The WaqtWise authors",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "fonts": "node tools/copy-fonts.js",
    "postinstall": "node tools/copy-fonts.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "adhan": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.waqtwise.app",
    "productName": "WaqtWise",
    "copyright": "Copyright (C) 2026 The WaqtWise authors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WaqtWise",
      "artifactName": "WaqtWise-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "protocols": [
      {
        "name": "WaqtWise",
        "schemes": [
          "waqtwise"
        ]
      }
    ]
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://waqtwise-author.github.io/WaqtWise/",
  "repository": { "type": "git", "url": "git+https://github.com/WaqtWise-Author/WaqtWise.git" },
  "bugs": { "url": "https://github.com/WaqtWise-Author/WaqtWise/issues" },
  "keywords": [
    "planner",
    "prayer-times",
    "salah",
    "tasks",
    "electron",
    "windows",
    "arabic",
    "rtl"
  ]
}
