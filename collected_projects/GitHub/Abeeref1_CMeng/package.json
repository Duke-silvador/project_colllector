{
  "name": "cmeng",
  "version": "0.1.0",
  "private": true,
  "description": "CMeng controlled construction/project evidence and intelligence platform",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:unit": "npm run build && node --test $(find dist/tests -name '*.test.js' ! -name '*-scale.test.js')",
    "test:stress": "npm run build && node --test dist/tests/*-scale.test.js",
    "test": "npm run test:unit",
    "verify": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "iconv-lite": "0.6.3",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.2.5",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "node": ">=22"
  }
}
