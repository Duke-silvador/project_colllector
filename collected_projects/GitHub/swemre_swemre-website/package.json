{
  "name": "swemre-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "checkstyle": "eslint . && prettier --check . && node scripts/license-headers.mjs --check",
    "checkstyle:fix": "eslint . --fix && prettier --write . && node scripts/license-headers.mjs --fix",
    "rss": "node --experimental-strip-types --no-warnings scripts/generate-rss.mjs",
    "sitemap": "node --experimental-strip-types --no-warnings scripts/generate-sitemap.mjs",
    "prerender": "node --experimental-strip-types --no-warnings scripts/prerender.mjs",
    "predev": "npm run rss && npm run sitemap",
    "prebuild": "npm run rss && npm run sitemap",
    "postbuild": "npm run prerender",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gts": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "author": "swemre <emre@swemre.com>",
  "license": "SEE LICENSE IN LICENSE"
}
