{
  "name": "tandem",
  "version": "0.0.0",
  "description": "Company workspace where human and AI employees work together — SSH environments run the Hermes agent as the task runner.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "bun .output/server/index.mjs",
    "typecheck": "bunx vue-tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "nuxt prepare",
    "gen:auth": "bun run scripts/gen-auth-schema.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.11.3",
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/publisher": "2.0.0-beta.42",
    "@orpc/server": "2.0.0-beta.42",
    "@orpc/tanstack-query": "2.0.0-beta.42",
    "@tanstack/vue-query": "5.104.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-auth": "1.7.7",
    "bullmq": "^6.3.14",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.52.0",
    "ioredis": "^6.0.0",
    "nuxt": "4.6.0",
    "postgres": "3.4.7",
    "ssh2": "^1.17.0",
    "zod": "4.6.5"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@dxup/nuxt": "0.5.10",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "1.64.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "26.6.4",
    "@types/ssh2": "^1.15.6",
    "@vitest/browser": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "bun-types": "1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "^21.0.1",
    "semantic-release": "24.2.3",
    "type-fest": "^5.10.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "typescript-native-bridge": "6.0.3-bridge.18.tsgo.7.0.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/namhtpyn/tandem.git"
  },
  "author": "namhtpyn",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "overrides": {
    "esbuild": "0.25.12",
    "typescript": "$typescript"
  }
}