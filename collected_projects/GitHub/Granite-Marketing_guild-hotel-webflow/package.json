{
  "name": "@granite-marketing/webflow-mcp-starter",
  "version": "1.1.4",
  "description": "Granite Marketing's private hybrid Webflow factory for React DevLink projects and native Webflow runtimes.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "create:client": "node ./scripts/factory/create-client-project.mjs",
    "test:factory": "node --test tests/factory/*.test.mjs",
    "factory:verify": "pnpm test:factory && pnpm check && pnpm build && pnpm test:figma",
    "factory:tokens": "node ./scripts/factory/generate-token-adapters.mjs",
    "factory:blueprint": "node ./scripts/factory/validate-blueprint.mjs",
    "factory:snapshot": "node ./scripts/factory/inspect-webflow.mjs",
    "factory:drift": "node ./scripts/factory/diff-webflow-state.mjs",
    "test": "npx playwright test",
    "test:capture": "npx playwright test --grep 'capture'",
    "test:regression": "npx playwright test --grep 'regression'",
    "test:update-baseline": "npx playwright test --update-snapshots",
    "setup": "npx playwright install chromium",
    "build": "cross-env NODE_ENV=production node ./bin/build.js",
    "dev": "cross-env NODE_ENV=development node ./bin/build.js --watch",
    "preview:fixtures": "esbuild tests/visual/fixtures/*.ts --bundle --outdir=tests/visual/fixtures --servedir=. --serve=3001",
    "watch": "cross-env NODE_ENV=development node ./bin/build.js --watch",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "release": "changeset publish",
    "export-assets": "node scripts/api/figma/export-assets.cjs",
    "upload-assets": "node scripts/api/webflow/upload-assets.cjs",
    "update-metadata": "node scripts/api/webflow/update-metadata.cjs",
    "update-seo": "node scripts/api/webflow/update-seo.cjs",
    "parse-copy": "node scripts/api/webflow/parse-copy.cjs",
    "alt:inventory": "node scripts/api/anthropic/build-alt-inventory.mjs",
    "alt:generate": "node scripts/api/anthropic/generate-alt-text.mjs",
    "alt:payload": "node scripts/api/anthropic/build-apply-payload.mjs",
    "alt:apply": "node scripts/api/webflow/apply-alt-text.cjs",
    "alt:verify": "node scripts/api/anthropic/verify-live-alt.mjs",
    "figma:snapshot": "node scripts/api/figma/snapshot.mjs",
    "figma:slice": "node scripts/api/figma/slice-sections.mjs",
    "figma:tokens": "node scripts/api/figma/extract-tokens.mjs",
    "test:figma": "node --test tests/figma/*.test.mjs",
    "figma:inventory": "node scripts/api/figma/build-inventory.mjs",
    "figma:vectors": "node scripts/api/figma/export-vectors.mjs",
    "figma:queue": "node scripts/api/figma/build-queue.mjs"
  },
  "keywords": [
    "webflow",
    "figma",
    "mcp",
    "claude-code",
    "automation",
    "playwright",
    "granite-marketing",
    "template",
    "devlink",
    "code-components",
    "private-factory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Granite-Marketing/webflow-mcp-starter.git"
  },
  "homepage": "https://github.com/Granite-Marketing/webflow-mcp-starter",
  "bugs": {
    "url": "https://github.com/Granite-Marketing/webflow-mcp-starter/issues"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "lenis": "^1.0.45",
    "mammoth": "^1.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.4",
    "http-server": "^14.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
