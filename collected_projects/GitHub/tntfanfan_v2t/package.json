{
  "name": "english-garden-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node frontend/web/scripts/serve.mjs",
    "build": "node frontend/web/scripts/build.mjs",
    "preview": "node frontend/web/scripts/serve.mjs",
    "test:web": "node frontend/web/tests/browser.cjs",
    "build:mini": "node frontend/miniprogram/scripts/sync-content.cjs",
    "test:mini": "node --test frontend/miniprogram/tests/*.test.cjs",
    "verify:mini": "node frontend/miniprogram/scripts/verify.cjs",
    "test:web:logic": "node --test frontend/web/tests/*.test.cjs"
  }
}
