{
  "name": "@cgon/leafer-x-feather",
  "version": "0.1.8",
  "description": "LeaferJS 的非破坏性轮廓羽化滤镜，支持多半径叠加与原生 JSON",
  "keywords": [
    "leaferjs",
    "leafer",
    "filter",
    "feather",
    "canvas",
    "graphics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gws890814/leafer-x-feather.git"
  },
  "homepage": "https://github.com/gws890814/leafer-x-feather#readme",
  "bugs": {
    "url": "https://github.com/gws890814/leafer-x-feather/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/feather.global.js",
  "jsdelivr": "./dist/feather.global.js",
  "files": ["dist", "types", "branding/logo.svg", "branding/logo-mark.svg", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "LICENSE"],
  "sideEffects": ["./dist/index.js", "./dist/index.cjs", "./dist/feather.global.js"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4186 --strictPort",
    "clean": "node clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node build.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 4187 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json && npm run build && npm run test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@leafer-in/filter": ">=2.2.9 <3",
    "@leafer-ui/core": ">=2.2.9 <3",
    "@leafer-ui/interface": ">=2.2.9 <3"
  },
  "devDependencies": {
    "@leafer-in/arrow": "2.2.9",
    "@leafer-in/filter": "2.2.9",
    "@leafer-ui/core": "2.2.9",
    "@leafer-ui/interface": "2.2.9",
    "@types/node": "^24.13.3",
    "leafer-ui": "2.2.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
