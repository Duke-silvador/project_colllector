{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "long-title": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "no-redundant-role": "off",
    "prefer-native-element": "off",
    "doctype-style": "off",
    "void-style": "off",
    "attribute-empty-style": "off",
    "no-raw-characters": "off",
    "text-content": "off",
    "unique-landmark": "off",
    "valid-id": "off",
    "prefer-tbody": "off",
    "wcag/h32": "off"
  }
}
