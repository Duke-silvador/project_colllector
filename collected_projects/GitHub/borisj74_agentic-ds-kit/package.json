{
  "name": "kit-sandbox",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/kit"
  ],
  "scripts": {
    "generate:tokens": "npm run generate:tokens -w agentic-ds-kit",
    "dev": "next dev -H 127.0.0.1 -p 43123",
    "build": "npm run build -w agentic-ds-kit && next build",
    "start": "next start -H 127.0.0.1 -p 43123",
    "lint": "eslint",
    "test": "npm test -w agentic-ds-kit",
    "sync:kit-docs": "node scripts/sync-kit-version-docs.mjs",
    "bump:kit": "npm version --no-git-tag-version -w agentic-ds-kit",
    "publish:kit": "npm run sync:kit-docs && npm publish -w agentic-ds-kit --access public"
  },
  "dependencies": {
    "agentic-ds-kit": "*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
