{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "980px"
    },
    "color": {
      "palette": [
        { "slug": "cream", "name": "Crema", "color": "#f5f0e6" },
        { "slug": "paper", "name": "Papel", "color": "#fffdf8" },
        { "slug": "ink", "name": "Tinta", "color": "#1f261f" },
        { "slug": "green", "name": "Verde FOOD", "color": "#244b35" },
        { "slug": "terracotta", "name": "Terracota", "color": "#b85f3d" },
        { "slug": "mustard", "name": "Mostaza", "color": "#d1a94b" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Sans", "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif" },
        { "slug": "serif", "name": "Editorial", "fontFamily": "Georgia, 'Times New Roman', serif" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "#f5f0e6",
      "text": "#1f261f"
    },
    "typography": {
      "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      },
      "link": {
        "color": { "text": "#244b35" }
      }
    }
  }
}
