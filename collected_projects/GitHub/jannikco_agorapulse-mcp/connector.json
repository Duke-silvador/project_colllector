      "description": "Create an internal calendar note; does not publish a social post.",
      "method": "POST",
      "path": "/v1.0/publishing/organizations/{organizationId}/workspaces/{workspaceId}/notes",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "integer",
            "minimum": 1
          },
          "workspaceId": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "BLUE",
              "RED",
              "YELLOW",
              "GREEN",
              "PURPLE",
              "PINK",
              "ORANGE",
              "MINT",
              "CYAN",
              "GREY"
            ]
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        },
        "required": [
          "organizationId",
          "workspaceId",
          "title",
          "color",
          "startDate",
          "endDate"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "organizationId",
          "workspaceId"
        ],
        "query": {},
        "body": {
          "title": "title",
          "body": "body",
          "color": "color",
          "startDate": "startDate",
          "endDate": "endDate"
        }
      },
