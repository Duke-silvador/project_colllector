{
  "openapi": "3.1.0",
  "info": {
    "title": "Agorapulse selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.agorapulse.com"
    }
  ],
  "paths": {
    "/v1.0/core/organizations": {
      "get": {
        "operationId": "agorapulse_list_organizations",
        "summary": "agorapulse list organizations",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/v1.0/core/organizations/{organizationId}/workspaces/{workspaceId}/profiles": {
      "get": {
        "operationId": "agorapulse_list_profiles",
        "summary": "agorapulse list profiles",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/v1.0/publishing/organizations/{organizationId}/workspaces/{workspaceId}/notes": {
      "post": {
        "operationId": "agorapulse_create_calendar_note",
        "summary": "Create an internal calendar note; does not publish a social post.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "BLUE",
                      "RED",
                      "YELLOW",
                      "GREEN",
                      "PURPLE",
                      "PINK",
                      "ORANGE",
                      "MINT",
                      "CYAN",
                      "GREY"
                    ]
                  },
                  "startDate": {
                    "type": "string"
                  },
                  "endDate": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "color",
                  "startDate",
                  "endDate"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
