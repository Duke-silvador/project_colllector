    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.1.2",
    "lucide-react": "^0.511.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.5.1",
