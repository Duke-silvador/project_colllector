{
  "name": "@doomerlabs/doomer",
  "version": "0.1.0",
  "description": "Doomer Quick reviews and deterministic coding-agent setup",
  "type": "module",
  "bin": {
    "doomer": "bin/doomer.js"
  },
  "engines": {
    "node": ">=22"
  },
