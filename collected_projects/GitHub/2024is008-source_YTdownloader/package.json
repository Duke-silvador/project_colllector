{
  "name": "ytdownloader-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "worker": "node backend/worker.js",
    "cleanup": "node backend/cleanup.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/downloader.test.js test/integration/system.test.js",
    "test:python": "python3 -m unittest discover -s test -p test_*.py",
    "test:integration": "node --test --test-concurrency=1 test/integration/system.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "ioredis": "6.0.0"
  }
}
