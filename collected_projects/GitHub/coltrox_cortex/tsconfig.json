{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@compartilhado/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src",
    "web",
    "api"
  ]
}
