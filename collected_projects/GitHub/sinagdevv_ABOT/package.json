{
  "name": "abot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w packages/agent && npm run typecheck -w packages/shared"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
