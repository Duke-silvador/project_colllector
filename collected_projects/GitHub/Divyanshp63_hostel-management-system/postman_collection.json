{
  "info": {
    "name": "Hostel & PG Management System API",
    "description": "Comprehensive Postman Collection for Spring Boot 3.3.4 REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:2007",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hostel.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login (Student)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@hostel.com\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard Cockpit",
      "item": [
        {
          "name": "Get Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/dashboard/admin", "host": ["{{base_url}}"], "path": ["api", "dashboard", "admin"] }
          }
        },
        {
          "name": "Get Student Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/dashboard/student", "host": ["{{base_url}}"], "path": ["api", "dashboard", "student"] }
          }
        }
      ]
    },
    {
      "name": "3. Rooms & Allocations",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/rooms", "host": ["{{base_url}}"], "path": ["api", "rooms"] }
          }
        },
        {
          "name": "Get Available Rooms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/rooms/available", "host": ["{{base_url}}"], "path": ["api", "rooms", "available"] }
          }
        },
        {
          "name": "Student Request Room Allocation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 1,\n  \"remarks\": \"Prefer ground floor room\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/allocations/request", "host": ["{{base_url}}"], "path": ["api", "allocations", "request"] }
          }
        },
        {
          "name": "Warden Approve Allocation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allocationId\": 1,\n  \"remarks\": \"Approved\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/allocations/approve", "host": ["{{base_url}}"], "path": ["api", "allocations", "approve"] }
          }
        }
      ]
    },
    {
      "name": "4. Fees & Payments",
      "item": [
        {
          "name": "Generate Bulk Monthly Invoices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": \"2026-11\",\n  \"dueDate\": \"2026-11-15\",\n  \"messFee\": 2500,\n  \"electricityFee\": 500,\n  \"maintenanceFee\": 500\n}"
            },
            "url": { "raw": "{{base_url}}/api/fees/bulk", "host": ["{{base_url}}"], "path": ["api", "fees", "bulk"] }
          }
        },
        {
          "name": "Get My Fees (Student)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/fees/my", "host": ["{{base_url}}"], "path": ["api", "fees", "my"] }
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feeId\": 1,\n  \"amount\": 5000.00,\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/payments", "host": ["{{base_url}}"], "path": ["api", "payments"] }
          }
        }
      ]
    },
    {
      "name": "5. Mess Timetable",
      "item": [
        {
          "name": "Get Today's Menu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/mess-menu/today", "host": ["{{base_url}}"], "path": ["api", "mess-menu", "today"] }
          }
        },
        {
          "name": "Get Full 7-Day Weekly Menu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/mess-menu/weekly", "host": ["{{base_url}}"], "path": ["api", "mess-menu", "weekly"] }
          }
        }
      ]
    },
    {
      "name": "6. PDF Reports & Receipts",
      "item": [
        {
          "name": "Download Fee Receipt PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/reports/fee-receipt/1", "host": ["{{base_url}}"], "path": ["api", "reports", "fee-receipt", "1"] }
          }
        },
        {
          "name": "Download Monthly Financial PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/reports/financial/monthly?month=2026-10", "host": ["{{base_url}}"], "path": ["api", "reports", "financial", "monthly"], "query": [{ "key": "month", "value": "2026-10" }] }
          }
        },
        {
          "name": "Download Room Occupancy PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/reports/occupancy", "host": ["{{base_url}}"], "path": ["api", "reports", "occupancy"] }
          }
        }
      ]
    }
  ]
}
