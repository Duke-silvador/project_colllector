{
  "name": "razor-sdk-root",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "src/Sdk",
  "targets": {
    "lint": {
      "command": "dotnet format --verify-no-changes Sdk.slnx"
    },
    "test": {
      "command": "bash scripts/test.sh"
    },
    "build": {
      "command": "bash scripts/build.sh"
    },
    "audit": {
      "command": "dotnet list src/Sdk/Sdk.csproj package --vulnerable --include-transitive || true"
    }
  },
  "tags": [
    "profile:d",
    "scope:shared"
  ]
}
