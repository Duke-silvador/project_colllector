{
  "name": "monitoramento-el-nino-jbs-terminais",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "collect": "tsx scripts/collectors/collect.ts",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:edge",
    "lint": "eslint .",
    "test": "vitest run",
    "territory:prepare": "tsx scripts/territory/generate.ts --prepare",
    "territory:generate": "tsx scripts/territory/generate.ts",
    "typecheck:edge": "tsc --noEmit -p supabase/tsconfig.json",
    "map:collect": "tsx scripts/map/collect.ts",
    "automation:update": "tsx scripts/automation/update.ts",
    "data:validate": "tsx scripts/automation/validate.ts",
    "pages:build": "npm run typecheck && vite build --mode pages",
    "pages:validate": "tsx scripts/automation/validate.ts --artifact",
    "pages:preview": "vite preview --mode pages --host 127.0.0.1",
    "pages:smoke": "tsx scripts/automation/smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "ol": "^10.10.0",
    "ol-mapbox-style": "^13.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.1",
    "parse5": "^8.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
