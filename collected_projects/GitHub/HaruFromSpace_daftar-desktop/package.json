{
  "name": "daftar-desktop",
  "productName": "Daftar",
  "version": "1.0.0",
  "description": "Daftar for Windows: your GJU courses, deadlines and notes, with deadline reminders.",
  "author": "HaruFromSpace",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "app.daftar.desktop",
    "productName": "Daftar",
    "copyright": "Made by a GJU student. Not an official GJU app.",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/tray.png",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "./after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Daftar-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Daftar",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HaruFromSpace",
        "repo": "daftar-desktop",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "compression": "maximum"
  }
}
