{
  "name": "ideaclip",
  "private": true,
  "version": "0.2.23",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-ai-schema.mjs && npm run typecheck && vite build && vite build --config vite.content.config.ts && vite build --config vite.assist.config.ts && node scripts/check-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:native": "playwright test --config playwright.native.config.ts",
    "proxy:research": "node tools/research-proxy.ts",
    "handoff:local": "node tools/codex-handoff.ts",
    "handoff:preflight": "node tools/codex-preflight.ts",
    "handoff:executor": "node tools/controlled-executor.ts",
    "handoff:task": "node tools/local-task.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "parse5": "8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
