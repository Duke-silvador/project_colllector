{
  "name": "agent-trace-sanitizer",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript library for safely sanitizing AI-agent execution traces, tool-call logs, and structured telemetry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist dist-test",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "test:consumer": "node scripts/verify-consumer.js",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "security:scan": "gitleaks detect --no-git --source . --config .gitleaks.toml",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashDoesCode/agent-trace-sanitizer.git"
  },
  "keywords": [
    "agent",
    "ai",
    "trace",
    "sanitizer",
    "redact",
    "secrets",
    "telemetry",
    "llm",
    "opentelemetry",
    "security"
  ],
  "author": "Yash Srivastava",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/YashDoesCode/agent-trace-sanitizer/issues"
  },
  "homepage": "https://github.com/YashDoesCode/agent-trace-sanitizer#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
