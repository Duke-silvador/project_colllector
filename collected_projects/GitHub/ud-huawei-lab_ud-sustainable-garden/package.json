{
  "name": "ud-sustainable-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test server/*.test.js",
    "check": "node --check server/index.js && node --check server/app.js && node --check server/ha.js && node --check server/auth.js && node --check server/store.js && node --check server/tickets.js && node --check api/garden.js",
    "auth:setup": "node scripts/configure-auth.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "hls.js": "^1.6.13",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.187.0",
    "undici": "^8.12.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "prettier": "^3.9.10",
    "vite": "^8.0.1"
  }
}
