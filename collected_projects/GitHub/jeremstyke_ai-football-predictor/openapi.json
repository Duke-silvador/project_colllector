{
    "info": {
        "title": "AI Football Predictor free API",
        "contact": {
            "url": "https://aifootpredictor.com/api/"
        },
        "version": "1.0.0",
        "description": "Free football match probabilities, expected goals, most likely score, predicted tables and pre-match article excerpts for 29 competitions. Free key at https://aifootpredictor.com/api/ (5,000 requests a day). Rule: show a visible link to aifootpredictor.com on every page that displays this data; the `attribution` block of each response is ready to display.",
        "termsOfService": "https://aifootpredictor.com/api/"
    },
    "paths": {
        "/tables": {
            "get": {
                "summary": "Predicted end-of-season table (20,000 simulations)",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "rank": {
                                                        "type": "integer"
                                                    },
                                                    "team": {
                                                        "type": "string"
                                                    },
                                                    "title": {
                                                        "type": "number",
                                                        "maximum": 1,
                                                        "minimum": 0
                                                    },
                                                    "played": {
                                                        "type": "integer"
                                                    },
                                                    "points": {
                                                        "type": "integer"
                                                    },
                                                    "relegation": {
                                                        "type": "number",
                                                        "maximum": 1,
                                                        "minimum": 0
                                                    },
                                                    "attack_rating": {
                                                        "type": "number"
                                                    },
                                                    "defence_rating": {
                                                        "type": "number"
                                                    },
                                                    "expected_points": {
                                                        "type": "number"
                                                    },
                                                    "expected_position": {
                                                        "type": "number"
                                                    }
                                                },
                                                "additionalProperties": true
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "attribution": {
                                            "$ref": "#/components/schemas/Attribution"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "Table"
                    },
                    "401": {
                        "$ref": "#/components/responses/Error"
                    },
                    "403": {
                        "$ref": "#/components/responses/Error"
                    },
                    "429": {
                        "$ref": "#/components/responses/Error"
                    }
                },
                "parameters": [
                    {
                        "in": "query",
                        "name": "competition",
                        "schema": {
                            "enum": [
                                "E0",
                                "SP1",
                                "I1",
                                "D1",
                                "F1",
                                "P1",
                                "N1",
                                "T1"
                            ],
                            "type": "string"
                        },
                        "description": "Without it, returns the list of available tables"
                    }
                ],
                "operationId": "getTables"
            }
        },
        "/matches": {
            "get": {
                "summary": "A day's matches with probabilities",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Match"
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "attribution": {
                                            "$ref": "#/components/schemas/Attribution"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "Matches"
                    },
                    "401": {
                        "$ref": "#/components/responses/Error"
                    },
                    "403": {
                        "$ref": "#/components/responses/Error"
                    },
                    "429": {
                        "$ref": "#/components/responses/Error"
                    }
                },
                "parameters": [
                    {
                        "in": "query",
                        "name": "date",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "description": "YYYY-MM-DD (UTC), default today"
                    },
                    {
                        "in": "query",
                        "name": "competition",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Competition code, see /competitions"
                    },
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "enum": [
                                "all",
                                "upcoming",
                                "finished"
                            ],
                            "type": "string"
                        }
                    }
                ],
                "operationId": "getMatches"
            }
        },
        "/articles": {
            "get": {
                "summary": "Pre-match article excerpts with a mandatory link to the full article",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "url": {
                                                        "type": "string"
                                                    },
                                                    "lede": {
                                                        "type": "string"
                                                    },
                                                    "title": {
                                                        "type": "string"
                                                    },
                                                    "excerpt": {
                                                        "type": "string"
                                                    },
                                                    "kickoff": {
                                                        "type": "string"
                                                    },
                                                    "read_more": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": "string"
                                                            },
                                                            "html": {
                                                                "type": "string"
                                                            },
                                                            "text": {
                                                                "type": "string"
                                                            },
                                                            "required": {
                                                                "type": "boolean"
                                                            }
                                                        }
                                                    },
                                                    "published_at": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "attribution": {
                                            "$ref": "#/components/schemas/Attribution"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "Articles"
                    },
                    "401": {
                        "$ref": "#/components/responses/Error"
                    },
                    "403": {
                        "$ref": "#/components/responses/Error"
                    },
                    "429": {
                        "$ref": "#/components/responses/Error"
                    }
                },
                "parameters": [
                    {
                        "in": "query",
                        "name": "lang",
                        "schema": {
                            "enum": [
                                "en",
                                "fr"
                            ],
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "date",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "description": "Kickoff day"
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "maximum": 50,
                            "minimum": 1
                        }
                    }
                ],
                "operationId": "getArticles"
            }
        },
        "/reliability": {
            "get": {
                "summary": "Brier score and log loss on finished matches",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object"
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "attribution": {
                                            "$ref": "#/components/schemas/Attribution"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "Reliability"
                    },
                    "401": {
                        "$ref": "#/components/responses/Error"
                    },
                    "403": {
                        "$ref": "#/components/responses/Error"
                    },
                    "429": {
                        "$ref": "#/components/responses/Error"
                    }
                },
                "operationId": "getReliability"
            }
        },
        "/competitions": {
            "get": {
                "summary": "Competition codes covered",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "code": {
                                                        "type": "string"
                                                    },
                                                    "matches_last_30_days": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "attribution": {
                                            "$ref": "#/components/schemas/Attribution"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "Competitions"
                    },
                    "401": {
                        "$ref": "#/components/responses/Error"
                    },
                    "403": {
                        "$ref": "#/components/responses/Error"
                    },
                    "429": {
                        "$ref": "#/components/responses/Error"
                    }
                },
                "operationId": "getCompetitions"
            }
        }
    },
    "openapi": "3.0.3",
    "servers": [
        {
            "url": "https://api.aifootpredictor.com/api/v1"
        }
    ],
    "security": [
        {
            "ApiKey": [
            ]
        }
    ],
    "components": {
        "schemas": {
            "Match": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string",
                        "description": "Match page on aifootpredictor.com"
                    },
                    "away": {
                        "type": "string"
                    },
                    "home": {
                        "type": "string"
                    },
                    "result": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "away": {
                                "type": "integer"
                            },
                            "home": {
                                "type": "integer"
                            },
                            "most_likely_happened": {
                                "type": "boolean"
                            }
                        }
                    },
                    "status": {
                        "enum": [
                            "upcoming",
                            "finished"
                        ],
                        "type": "string"
                    },
                    "kickoff": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "top_scores": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "score": {
                                    "type": "string"
                                },
                                "probability": {
                                    "type": "number",
                                    "maximum": 1,
                                    "minimum": 0
                                }
                            }
                        },
                        "nullable": true
                    },
                    "clean_sheet": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "away": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            },
                            "home": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            }
                        }
                    },
                    "competition": {
                        "type": "string"
                    },
                    "most_likely": {
                        "type": "object",
                        "properties": {
                            "outcome": {
                                "enum": [
                                    "home",
                                    "draw",
                                    "away"
                                ],
                                "type": "string"
                            },
                            "probability": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            }
                        }
                    },
                    "likely_score": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "score": {
                                "type": "string"
                            },
                            "probability": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            }
                        }
                    },
                    "double_chance": {
                        "type": "object",
                        "properties": {
                            "away_or_draw": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            },
                            "home_or_away": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            },
                            "home_or_draw": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            }
                        }
                    },
                    "probabilities": {
                        "type": "object",
                        "properties": {
                            "away": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            },
                            "draw": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            },
                            "home": {
                                "type": "number",
                                "maximum": 1,
                                "minimum": 0
                            }
                        }
                    },
                    "expected_goals": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "away": {
                                "type": "number"
                            },
                            "home": {
                                "type": "number"
                            }
                        }
                    },
                    "over_2_5_goals": {
                        "type": "number",
                        "maximum": 1,
                        "minimum": 0
                    },
                    "both_teams_score": {
                        "type": "number",
                        "maximum": 1,
                        "minimum": 0,
                        "nullable": true
                    }
                }
            },
            "Attribution": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "html": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean"
                    }
                }
            }
        },
        "responses": {
            "Error": {
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "message": {
                                    "type": "string"
                                },
                                "attribution": {
                                    "$ref": "#/components/schemas/Attribution"
                                }
                            }
                        }
                    }
                },
                "description": "invalid_key, link_missing, wrong_origin or daily_limit"
            }
        },
        "securitySchemes": {
            "ApiKey": {
                "in": "header",
                "name": "X-API-Key",
                "type": "apiKey"
            }
        }
    },
    "externalDocs": {
        "url": "https://aifootpredictor.com/api/"
    }
}