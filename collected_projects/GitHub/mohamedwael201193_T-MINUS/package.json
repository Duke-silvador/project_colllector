{
  "name": "tminus",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "anchor build",
    "test:program": "anchor test",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/keeper/tsconfig.json --noEmit && tsc -p packages/sdk/tsconfig.json --noEmit",
    "lint": "node scripts/secret-scan.mjs",
    "test": "pnpm --filter @tminus/sdk test && pnpm --filter @tminus/api test && pnpm --filter @tminus/keeper test && node --import tsx --test frontend/src/lib/tminus/adapters/receiptMap.test.ts frontend/src/lib/tminus/wallet/safeAmount.test.ts",
    "secret-scan": "node scripts/secret-scan.mjs",
    "inspect:mint": "tsx scripts/inspect-mint.ts",
    "phase7": "node --import tsx scripts/phase7-live.ts",
    "e2e:devnet": "node --import tsx scripts/e2e-devnet.ts",
    "e2e:devnet-keeper": "node --import tsx scripts/e2e-devnet-keeper.ts",
    "e2e:devnet-failsafe": "node --import tsx scripts/e2e-devnet-failsafe-tick.ts",
    "e2e:devnet-double-fill": "node --import tsx scripts/e2e-devnet-double-fill.ts",
    "receipts:ingest-devnet": "node --import tsx scripts/ingest-devnet-receipts.ts",
    "preflight:mainnet": "node scripts/mainnet-preflight.mjs",
    "rent:mainnet": "node scripts/mainnet-rent.mjs",
    "sim:compose": "pnpm --filter @tminus/keeper sim:compose",
    "migrate": "pnpm --filter @tminus/api migrate"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "mocha": "^11.7.2",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5"
  }
}
