    "strip",
    "clean",
    "cleaner",
    "minify",
    "cli",
    "source-code",
    "code-cleaner"
  ],
  "homepage": "https://github.com/burak4ydin/commentor#readme",
  "bugs": {
    "url": "https://github.com/burak4ydin/commentor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Burak Aydın",
    "url": "https://github.com/burak4ydin"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "commentor": "./bin/commentor.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
