{
  "name": "kto-iz-nas",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "Party game for a TV and phones over local Wi-Fi",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'client/**' server/main.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && NODE_ENV=production node dist-server/server/main.js",
    "serve": "NODE_ENV=production node dist-server/server/main.js",
    "test": "vitest run",
    "test:ui": "npm run build && playwright test",
    "load": "npm run build && node scripts/load.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "desktop:sidecar": "node scripts/build-sidecar.mjs",
    "desktop:dev": "vite build && node scripts/build-sidecar.mjs && tauri dev",
    "desktop:prepare": "vite build && node scripts/build-sidecar.mjs && tsx scripts/tts-bundle.ts && tsx scripts/tts-pack.ts && tsx scripts/tts-runtime.ts",
    "desktop:build": "tauri build",
    "tts:prebuild": "tsx scripts/tts-prebuild.ts",
    "tts:bundle": "tsx scripts/tts-bundle.ts",
    "tts:runtime": "tsx scripts/tts-runtime.ts",
    "tts:smoke": "tsx scripts/tts-smoke.ts",
    "emoji:fetch": "node scripts/fetch-emoji.mjs"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "express": "^5.2.1",
    "lottie-web": "^5.13.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "perfect-freehand": "^1.2.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
