{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "worker": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "tests_py/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-debugger": "error",
    "eqeqeq": ["warn", "smart"],
    "no-var": "error",
    "prefer-const": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/jsx-key": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "env": { "node": true }
    }
  ]
}
