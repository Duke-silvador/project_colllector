{
  "name": "wanxiang-engine",
  "version": "0.1.17",
  "description": "万象引擎 —— 可配置的等级(境界)/装备/属性/副本系统内核:换一套名称与内容,就能搭出自己的游戏",
  "author": "Mystvio",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pplmx/wanxiang-engine.git"
  },
  "homepage": "https://github.com/pplmx/wanxiang-engine#readme",
  "bugs": {
    "url": "https://github.com/pplmx/wanxiang-engine/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets/xiuxian": {
      "types": "./dist/presets/xiuxian.d.ts",
      "import": "./dist/presets/xiuxian.js"
    },
    "./presets/demo": {
      "types": "./dist/presets/demo.d.ts",
      "import": "./dist/presets/demo.js"
    },
    "./presets/daily": {
      "types": "./dist/presets/daily.d.ts",
      "import": "./dist/presets/daily.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "bun examples/from-zero.ts && bun examples/quickstart.ts && bun examples/minimal.ts && bun examples/combo-arts.ts && bun examples/daily-loop.ts && bun examples/quest-loop.ts && bun examples/collect-loop.ts && bun examples/shop-loop.ts && bun examples/world-loop.ts && bun examples/combat-takeover.ts && bun examples/arena-takeover.ts",
    "type-check:examples": "tsc -p tsconfig.examples.json",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json && vitest run && tsc -p tsconfig.build.json && node scripts/verify-dist.mjs && bun run examples"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "game-engine",
    "idle-game",
    "rpg",
    "level",
    "equipment",
    "attributes",
    "dungeon"
  ]
}
