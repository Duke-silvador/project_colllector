{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "strict": true,
    "noEmit": true,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
