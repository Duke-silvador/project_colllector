{
  "name": "travel-passport",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @tp/web dev",
    "dev:api": "pnpm --filter @tp/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @tp/db generate",
    "db:migrate": "pnpm --filter @tp/db migrate:dev",
    "db:seed": "pnpm --filter @tp/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
