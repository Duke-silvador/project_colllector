{
  "name": "eventpilot-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:server && npm run build:client",
    "test": "cd server && npm test",
    "test:critical": "cd server && npm run test:critical",
    "test:e2e": "cd server && npm run test:e2e",
    "lint": "cd client && tsc -b --noEmit && cd ../server && tsc --noEmit",
    "verify": "npm run lint && npm run build && npm run test:critical && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.14",
    "@rolldown/binding-linux-x64-musl": "^1.2.14",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
  },
  "type": "module"
}
