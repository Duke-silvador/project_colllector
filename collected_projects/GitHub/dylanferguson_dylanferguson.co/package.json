{
  "name": "dylanferguson.co",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Dylan Ferguson <dylan.b.ferguson@gmail.com>",
  "repository": "https://github.com/dylanferguson/dylanferguson.co",
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 BUILD_COMMIT=$(git rev-parse --short=7 HEAD) astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "deploy": "wrangler deploy",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 BUILD_COMMIT=$(git rev-parse --short=7 HEAD) WRITINGS=true astro dev",
    "format": "oxfmt --write package.json 'data/**/*.json5' 'src/**/*.{astro,css,js,ts,tsx,md,mdx}' 'scripts/**/*.{js,mjs,ts}' 'public/**/*.{css,js,html}'",
    "lint": "oxlint src scripts",
    "prepare": "git config core.hooksPath .githooks",
    "resume": "bash scripts/resume.sh",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "json5": "^2.2.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.0",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.2.2"
}
