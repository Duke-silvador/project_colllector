{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "number" }
      },
      "required": ["email"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Study subject entity",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 }
      },
      "required": ["name"]
    },
    "Material": {
      "title": "Material",
      "description": "Study material notes",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 50000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["subjectId", "title", "content"]
    },
    "AIInteraction": {
      "title": "AI Interaction",
      "description": "AI request log",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "maxLength": 128 },
        "actionType": { "type": "string", "maxLength": 50 },
        "prompt": { "type": "string", "maxLength": 5000 },
        "response": { "type": "string", "maxLength": 50000 },
        "route": { "type": "string", "maxLength": 50 },
        "latencyMs": { "type": "number" },
        "dataSavedBytes": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["actionType", "prompt", "timestamp"]
    },
    "Preferences": {
      "title": "Preferences",
      "description": "User app preferences",
      "type": "object",
      "properties": {
        "routingMode": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "maxLength": 20 },
        "fontSize": { "type": "string", "maxLength": 20 },
        "answerLength": { "type": "string", "maxLength": 20 },
        "studyLanguage": { "type": "string", "maxLength": 50 },
        "dailyStudyGoal": { "type": "number" },
        "remindersEnabled": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "User subjects collection"
    },
    "/users/{userId}/materials/{materialId}": {
      "schema": "Material",
      "description": "User study materials collection"
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "AIInteraction",
      "description": "User AI interactions request log"
    },
    "/users/{userId}/preferences/{preferenceId}": {
      "schema": "Preferences",
      "description": "User settings and preferences"
    }
  }
}
