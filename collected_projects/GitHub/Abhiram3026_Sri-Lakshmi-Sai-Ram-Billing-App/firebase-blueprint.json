{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account profile defining role and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["Owner", "Staff"] },
        "passwordHash": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "phone", "role", "passwordHash", "isActive"]
    },
    "Product": {
      "title": "Product",
      "description": "Product inventory details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "barcode": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "description": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "lowStockLimit": { "type": "number" }
      },
      "required": ["id", "name", "category", "barcode", "sellingPrice", "purchasePrice", "stockQuantity", "lowStockLimit"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profiles and metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "visitCount": { "type": "number" },
        "totalSpending": { "type": "number" },
        "lastPurchaseDate": { "type": "string" },
        "purchaseHistory": { "type": "array" }
      },
      "required": ["id", "name", "phone", "visitCount", "totalSpending"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Invoice/Bill details of transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "overallDiscountPercent": { "type": "number" },
        "overallDiscountAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["PAID", "CANCELLED"] }
      },
      "required": ["id", "billNumber", "date", "time", "items", "subtotal", "grandTotal", "paymentMethod", "status", "createdBy", "role"]
    },
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Store setup configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "storeLogo": { "type": "string" },
        "storeAddress": { "type": "string" },
        "gstNumber": { "type": "string" },
        "whatsAppNumber": { "type": "string" },
        "instagramLink": { "type": "string" },
        "googleMapsLink": { "type": "string" },
        "phoneNumber": { "type": "string" }
      },
      "required": ["storeName", "whatsAppNumber", "phoneNumber"]
    },
    "DailyReport": {
      "title": "Daily Report",
      "description": "Aggregated sales report by day",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "totalBills": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "cashRevenue": { "type": "number" },
        "upiRevenue": { "type": "number" },
        "totalDiscounts": { "type": "number" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "date", "totalBills", "totalRevenue"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Profile documents of the owner and staff members"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog and stock information"
    },
    "customers/{customerId}": {
      "schema": "Customer",
      "description": "Store customer metrics and profiles"
    },
    "bills/{billId}": {
      "schema": "Bill",
      "description": "Billing transaction details and status"
    },
    "settings/store_config": {
      "schema": "StoreSettings",
      "description": "Global settings for the fancy store"
    },
    "daily_reports/{reportId}": {
      "schema": "DailyReport",
      "description": "Aggregated metrics generated for end-of-day auditing"
    }
  }
}
