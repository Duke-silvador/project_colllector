{
  "name": "showme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run assets && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/*.test.mjs",
    "secrets:scan": "node tools/secrets-scan.mjs",
    "models:fetch": "node tools/fetch-vision-assets.mjs",
    "assets": "node tools/fetch-vision-assets.mjs && node tools/prepare-browser-assets.mjs",
    "verify": "node tools/verify.mjs",
    "evidence:seal": "node tools/seal-evidence.mjs",
    "eval": "node --import ./tools/register-typescript.mjs tools/eval.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "next": "15.5.28",
    "openai": "7.34.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
