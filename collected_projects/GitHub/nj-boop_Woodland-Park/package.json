{
  "name": "wildgrove-zoo",
  "private": true,
  "version": "0.20.0",
  "description": "Wildgrove Zoo: a 3D zoo-building management game that runs in the browser.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:test": "node tools/build.mjs --test",
    "test": "node tools/build.mjs --test && node tests/run.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tools/**/*.mjs\" \"tests/**/*.mjs\"",
    "models": "bash tools/build-models.sh"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "three": "^0.128.0"
  }
}
