{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "store.booksangdai.desktop",
  "productName": "Book Sangdai",
  "copyright": "Copyright © 2026 Book Sangdai",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "desktop/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "desktop/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Book Sangdai",
    "uninstallDisplayName": "Book Sangdai (บุ๊คสั่งได้)"
  }
}
