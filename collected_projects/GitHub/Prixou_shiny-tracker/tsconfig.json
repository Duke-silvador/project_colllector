{
  // Vérification des types (JSDoc) des couches sans interface : npm run typecheck.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/data/**/*.js",
    "src/domain/**/*.js",
    "src/lib/**/*.js",
    "src/services/**/*.js",
    "src/state/store.js",
    "src/state/persistence.js"
  ]
}
