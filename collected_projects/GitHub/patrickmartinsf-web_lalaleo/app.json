{
  "expo": {
    "name": "Palavrinhas do Léo",
    "slug": "palavrinhas-do-leo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "palavrinhas",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF3E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.palavrinhas.leo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O microfone é usado para gravar a voz do Léo falando cada palavrinha.",
        "NSPhotoLibraryUsageDescription": "As fotos são usadas para escolher a ilustração de cada palavrinha.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.palavrinhas.leo",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O microfone é usado para gravar a voz do Léo falando cada palavrinha."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "As fotos são usadas para escolher a ilustração de cada palavrinha.",
          "cameraPermission": "A câmera é usada para fotografar uma ilustração da palavrinha."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
