{
  "extends": "@cyc-seattle/ts-config/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", ".storybook", "stacks", "vite.config.ts", "playwright.config.ts"]
}
