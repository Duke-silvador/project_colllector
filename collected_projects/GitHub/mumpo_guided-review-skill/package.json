{
  "name": "guided-review-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "collect": "bun run packages/collector/src/cli.ts",
    "dev": "bun run dev:tui",
    "dev:tui": "bun run apps/tui/src/index.ts",
    "dev:web": "bun run --filter @guided-review/web dev",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "package:plugin": "bun run scripts/package-plugin.ts",
    "test:plugin": "bun run scripts/smoke-plugin.ts",
    "open:review": "bun run apps/launcher/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
