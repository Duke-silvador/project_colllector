{
  "name": "langchain-example",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: NestJS API + React web + shared package",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @app/shared build && concurrently -k -n shared,api,web -c gray,green,cyan \"pnpm --filter @app/shared dev\" \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "dev:api": "pnpm --filter @app/shared build && pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "lint": "eslint .",
    "checkstyle": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter @app/shared build && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @app/shared build && pnpm -r --if-present test:e2e",
    "db:create": "pnpm --filter @app/api db:create",
    "db:reset": "pnpm --filter @app/api db:reset",
    "migration:generate": "pnpm --filter @app/api migration:generate",
    "migration:run": "pnpm --filter @app/api migration:run",
    "migration:revert": "pnpm --filter @app/api migration:revert",
    "seed": "pnpm --filter @app/api seed",
    "infra:up": "docker compose up -d db redis",
    "infra:down": "docker compose stop db redis",
    "clean": "pnpm -r --if-present clean && rimraf .cache"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
