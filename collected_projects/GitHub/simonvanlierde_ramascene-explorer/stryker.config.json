{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "command",
	"commandRunner": {
		"command": "FC_SEED=1 node --test"
	},
	"mutate": [
		"flows.js"
	],
	"coverageAnalysis": "off",
	"ignorePatterns": [
		".venv",
		"__pycache__",
		".pytest_cache",
		"dist",
		"test-results",
		"playwright-report",
		"data/browser-engine",
		"data/ramascene-browser-engine*.tar"
	],
	"concurrency": 8,
	"reporters": [
		"clear-text",
		"json"
	],
	"jsonReporter": {
		"fileName": "reports/mutation/mutation.json"
	},
	"cleanTempDir": true,
	"thresholds": {
		"high": 85,
		"low": 75,
		"break": 75
	}
}
