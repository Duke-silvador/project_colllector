{
  "name": "poe-trade-helper",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "description": "Chrome extension for Path of Exile 2 trade search pages",
  "scripts": {
    "test": "npm --prefix ../TradeStylerWork run test:extension",
    "build": "esbuild src/content/index.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/content.js",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "chrome-types": "^0.1.360",
    "esbuild": "^0.28.2",
    "linkedom": "0.18.12",
    "typescript": "^5.9.2"
  }
}
