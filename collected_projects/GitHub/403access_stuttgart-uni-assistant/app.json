{
  "expo": {
    "name": "University Assistant",
    "slug": "university-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "universityassistant",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.demo.universityassistant",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.demo.universityassistant",
      "adaptiveIcon": {
        "backgroundColor": "#004191",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#004191",
          "imageWidth": 200
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "@preeternal/react-native-cookie-manager",
      "./plugins/withVpnTunnel",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Face ID wird verwendet, um die gespeicherte C@MPUS-Anmeldung zu entsperren."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "networkInspector": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
