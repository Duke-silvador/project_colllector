    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:ipa": "node scripts/build-ios-ipa.mjs",
    "ios:accounts": "node scripts/xcode-accounts.mjs",
    "dist:serve": "node dist-service/server.mjs",
    "dist:publish": "node scripts/publish-ipa.mjs",
    "dist:tunnel": "cloudflared --config dist-service/tunnel.yml tunnel run",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && tsx scripts/check-assistant.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/check-campus-db.ts && node --import tsx --test scripts/campus-headless.test.mjs scripts/campus-headless-login.test.mjs scripts/campus-progress.test.mjs scripts/campus-login-messages.test.mjs scripts/assistant-endpoints.test.mjs scripts/vpn-profile.test.mjs scripts/auth-user.test.mjs && node --test server/oidc.test.mjs server/campus.test.mjs server/db.test.mjs server/auth.test.mjs server/admin.test.mjs server/mail.test.mjs scripts/set-campus-secret.test.mjs scripts/tunnel-assistant.test.mjs scripts/build-ios-ipa.test.mjs scripts/xcode-accounts.test.mjs dist-service/server.test.mjs",
    "assistant": "node server/index.mjs",
    "assistant:tunnel": "node scripts/tunnel-assistant.mjs",
    "assistant:local": "node scripts/tunnel-assistant.mjs --clear",
    "beta:forms": "node scripts/create-beta-forms.mjs",
    "campus:secret": "node scripts/set-campus-secret.mjs",
    "campus:token": "node scripts/set-campus-secret.mjs token",
    "campus:session": "node scripts/set-campus-secret.mjs session",
    "campus:headless": "tsx scripts/campus-headless-login.mjs",
    "lint": "expo lint src app server scripts dist-service",
    "icons": "node scripts/generate-icons.mjs",
    "docs": "cd docs-site && bun run start",
    "docs:build": "cd docs-site && bun run build",
    "docs:serve": "cd docs-site && bun run serve",
    "site": "python3 -m http.server 4173 --directory site"
  },
  "private": true,
  "patchedDependencies": {
    "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch",
    "@aliakhgar1/react-native-openvpn@1.0.0": "patches/@aliakhgar1+react-native-openvpn@1.0.0.patch"
  }
}
