{
  "name": "atento",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview astro build && wrangler deploy --env preview",
    "db:migrate:local": "wrangler d1 migrations apply atento-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply atento-db --env preview --remote",
    "db:migrate:prod": "wrangler d1 migrations apply atento-db --remote",
    "seed": "tsx scripts/seed.ts",
    "agregar:local": "tsx scripts/agregar-local.ts",
    "prepare": "lefthook install",
    "test:admin": "vitest run -c vitest.admin.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@playwright/test": "1.64.0",
    "lefthook": "2.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
