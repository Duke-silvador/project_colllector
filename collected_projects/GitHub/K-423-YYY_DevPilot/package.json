{
  "name": "devpilot",
  "version": "0.1.0",
  "description": "DevPilot — Codex 的观察窗：本地只读的 AI 编程项目实时监控工作台",
  "main": "out/main/main.js",
  "private": true,
  "author": "DevPilot",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:replay": "node scripts/dev-replay.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:readonly": "node scripts/ci/readonly-lint.mjs",
    "ci": "npm run lint:readonly && npm run typecheck && npm test",
    "perf:resources": "tsx scripts/perf/measure-resources.ts --scenario=all --label=after",
    "verify:codexlog": "tsx scripts/perf/verify-codexlog.ts",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts",
    "gen:golden": "tsx scripts/gen-golden.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
