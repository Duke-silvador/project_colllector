{
  "name": "dsh-fork-merge",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "DSH (DeepSeek Harness) plugin that turns a forked session's work into a reviewed merge packet, injects it back into the parent session after human confirmation, and can replace model-visible history ranges.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/**/*.js",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/core.test.js test/commands.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V-dev-388/dsh-fork-merge.git"
  },
  "bugs": {
    "url": "https://github.com/V-dev-388/dsh-fork-merge/issues"
  },
  "homepage": "https://github.com/V-dev-388/dsh-fork-merge#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "fork",
    "merge",
    "context"
  ]
}
