{
  "name": "zamzam-foods",
  "productName": "Zamzam Foods",
  "private": true,
  "version": "1.0.1",
  "description": "Zamzam Foods — Enterprise Distribution Management System",
  "author": "Zamzam Foods",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-5173}",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-5173}",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run build && tauri build",
    "desktop:build:win": "npm run build && tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:mac": "npm run build && tauri build --target aarch64-apple-darwin",
    "desktop:build:linux": "npm run build && tauri build --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
