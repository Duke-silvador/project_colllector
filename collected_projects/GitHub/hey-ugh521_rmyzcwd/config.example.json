{
  "core": {
    "host": "127.0.0.1",
    "port": 8900,
    "api_key": "",
    "idle_sleep_sec": 600,
    "prewarm_on_start": false
  },
  "llm": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-flash",
    "timeout_sec": 120,
    "max_tool_rounds": 4
  },
  "gateway": {
    "url": "http://127.0.0.1:8899",
    "timeout_sec": 30,
    "host": "127.0.0.1"
  },
  "services": {
    "comfyui": {
      "enabled": true,
      "python": "${AI}\\comic\\ComfyUI_windows_portable\\python_embeded\\python.exe",
      "cwd": "${AI}\\comic\\ComfyUI_windows_portable",
      "args": [
        "-s",
        "ComfyUI\\main.py",
        "--windows-standalone-build",
        "--fp16-vae",
        "--preview-method",
        "taesd",
        "--port",
        "8188",
        "--disable-comfy-compiler"
      ],
      "health_url": "http://127.0.0.1:8188/system_stats",
      "port": 8188,
      "start_timeout_sec": 420,
      "env": {
        "SSL_CERT_FILE": "${AI}\\comic\\ComfyUI_windows_portable\\python_embeded\\Lib\\site-packages\\certifi\\cacert.pem",
        "REQUESTS_CA_BUNDLE": "${AI}\\comic\\ComfyUI_windows_portable\\python_embeded\\Lib\\site-packages\\certifi\\cacert.pem",
        "HF_ENDPOINT": "https://hf-mirror.com",
        "PYTHONUTF8": "1"
      },
      "autostart": false
    },
    "kokoro": {
      "enabled": true,
      "python": "${RUNTIME}/python-kokoro/Scripts/python.exe",
      "cwd": "${ROOT}",
      "args": [
        "ops/tts/kokoro_openai_api.py",
        "--port",
        "7870"
      ],
      "port": 7870,
      "start_timeout_sec": 180,
      "autostart": true,
      "env": {
        "MOBIUS_KOKORO_DIR": "${MODELS}/kokoro"
      }
    },
    "gateway": {
      "enabled": true,
      "python": "${RUNTIME}/python-gateway/Scripts/python.exe",
      "cwd": ".",
      "args": [
        "media_gateway\\server.py",
        "--port",
        "8899"
      ],
      "port": 8899,
      "start_timeout_sec": 60,
      "env": {
        "MOBIUS_COMFY_START_TIMEOUT": "420",
        "MOBIUS_VIEW_TIMEOUT": "480",
        "MOBIUS_TASK_STORE": "pg",
        "MOBIUS_TASK_DSN": "postgresql://postgres:${PG_PASSWORD}@127.0.0.1:55432/mobius",
        "MOBIUS_CORE_TASK_EVENT_URL": "http://127.0.0.1:8900/v1/tasks/events",
        "MOBIUS_WORKFLOWS_DIR": "${AI}\\comic\\workflows",
        "MOBIUS_COMFY_OUTPUT_DIR": "${AI}\\comic\\ComfyUI_windows_portable\\ComfyUI\\output"
      },
      "autostart": true
    },
    "f5": {
      "enabled": false,
      "port": 7871,
      "python": "${CONDA}\\open-webui\\python.exe",
      "cwd": "${TTS_WS}",
      "args": [
        "mobius_tts_api.py",
        "--port",
        "7871"
      ],
      "autostart": false
    },
    "gsv": {
      "enabled": true,
      "python": "${AI}\\GPT-SoVITS-v4\\GPT-SoVITS-v4-20250529-nvidia50\\runtime\\python.exe",
      "cwd": "${AI}\\GPT-SoVITS-v4\\GPT-SoVITS-v4-20250529-nvidia50",
      "args": [
        "${AI}\\gsv_supervisor.py"
      ],
      "port": 7871,
      "start_timeout_sec": 300,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "MOBIUS_GSV_ROOT": "${AI}/GPT-SoVITS-v4/GPT-SoVITS-v4-20250529-nvidia50",
        "MOBIUS_GSV_ADAPTER": "${AI}/gsv_openai_adapter.py"
      },
      "autostart": true,
      "kill_pattern": "api_v2\\.py|gsv_openai_adapter\\.py|gsv_supervisor\\.py",
      "ports": [
        7871,
        7873
      ]
    },
    "embed": {
      "enabled": true,
      "autostart": true,
      "python": "${RUNTIME}/python-memory/Scripts/python.exe",
      "cwd": ".",
      "args": [
        "ops\\memory\\embed_server.py",
        "--port",
        "8903"
      ],
      "port": 8903,
      "start_timeout_sec": 180,
      "env": {
        "PYTHONUTF8": "1",
        "MOBIUS_EMBED_PATH": "${AI}\\models\\bge-m3-st"
      }
    },
    "memory": {
      "enabled": true,
      "autostart": true,
      "python": "${RUNTIME}/python-gateway/Scripts/python.exe",
      "cwd": ".",
      "args": [
        "ops\\memory\\memory_mcp.py",
        "--port",
        "8902"
      ],
      "port": 8902,
      "start_timeout_sec": 90,
      "env": {
        "PYTHONUTF8": "1",
        "MOBIUS_ENV_FILE": "${AI}\\mobius\\.env"
      }
    },
    "powercontext": {
      "enabled": true,
      "autostart": true,
      "exe": "${HOME}\\.local\\bin\\powercontext.exe",
      "cwd": "${AI}\\powercontext-config",
      "args": [
        "server",
        "run",
        "--env-file",
        ".env"
      ],
      "port": 8000,
      "health_url": "http://127.0.0.1:8000/health",
      "start_timeout_sec": 120,
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "langbot": {
      "enabled": true,
      "autostart": true,
      "cwd": "${AI}\\langbot-native",
      "port": 5300,
      "health_url": "http://127.0.0.1:5300/healthz",
      "start_timeout_sec": 240,
      "exe": "${RUNTIME}/python-langbot/Scripts/python.exe",
      "args": [
        "main.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "VIRTUAL_ENV": "${RUNTIME}/python-langbot"
      },
      "kill_pattern": "langbot_plugin\\.cli|langbot-native\\\\.venv|langbot-native\\\\main\\.py|langbot-native.*main\\.py"
    },
    "napcat": {
      "enabled": true,
      "autostart": false,
      "note": "原生 NapCat 4.18.42 + QQ 9.9.33；启动需要管理员权限（UAC），故 autostart=false，由启动器提权拉起",
      "port": 3000,
      "start_timeout_sec": 120,
      "exe": "${RUNTIME}/napcat/launcher.bat",
      "cwd": "${RUNTIME}/napcat",
      "args": [],
      "ports": [
        3000,
        3001
      ]
    },
    "postgres": {
      "enabled": true,
      "autostart": true,
      "note": "便携 PostgreSQL 18.6（P4）；启动器需在 Core 之前拉起它（Core 自身也用本库）",
      "port": 55432,
      "start_timeout_sec": 60,
      "exe": "${RUNTIME}/postgres/pgsql/bin/pg_ctl.exe",
      "args": [
        "-D",
        "${RUNTIME}/postgres/data",
        "-o",
        "-p 55432 -c listen_addresses=127.0.0.1",
        "-l",
        "${RUNTIME}/postgres/pg.log",
        "start"
      ],
      "stop_exe": "${RUNTIME}/postgres/pgsql/bin/pg_ctl.exe",
      "stop_args": [
        "-D",
        "${RUNTIME}/postgres/data",
        "stop",
        "-m",
        "fast"
      ],
      "ports": [
        55432
      ]
    }
  },
  "characters_dir": "data/characters",
  "db": "data/mobius.db",
  "default_character": "bronya",
  "integrations": {
    "langbot": {
      "base_url": "http://127.0.0.1:5300",
      "api_key": "",
      "bot_id": "f128506b-a8aa-417c-9b55-39bc2fc99894",
      "db_path": "${LEGACY_LB}\\langbot.db",
      "timeout_sec": 20
    }
  },
  "db_backend": "pg",
  "db_dsn": "postgresql://postgres:${PG_PASSWORD}@127.0.0.1:55432/mobius_core",
  "launcher": {
    "core_python": "${RUNTIME}/python-core/Scripts/python.exe",
    "core_args": [
      "-m",
      "core.server"
    ],
    "pg_ctl": "${RUNTIME}/postgres/pgsql/bin/pg_ctl.exe",
    "pg_data": "${RUNTIME}/postgres/data",
    "pg_log": "${RUNTIME}/postgres/pg.log",
    "pg_port": 55432,
    "start_napcat": true,
    "elevate": true
  },
  "paths": {
    "AI": "${RUNTIME}",
    "CONDA": "${RUNTIME}/conda",
    "HOME": "${USERPROFILE}",
    "TTS_WS": "${RUNTIME}",
    "LEGACY_LB": "${ROOT}/data/legacy-langbot",
    "RUNTIME": "${ROOT}/runtime"
  },
  "_comment": "示例配置：${VAR} 由启动器/Core 展开。paths 为外部运行时根目录，安装器会按实际布局写入。"
}