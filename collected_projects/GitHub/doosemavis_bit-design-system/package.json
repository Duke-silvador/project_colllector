{
  "name": "bit-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @bit-ds/react build",
    "verify": "pnpm --filter @bit-ds/react verify",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm --filter @bit-ds/react test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "versions": "node scripts/versions.mjs --out apps/gallery/public/versions.json",
    "logo:svg": "node scripts/build-logo-svg.mjs",
    "icons": "node scripts/build-icons.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "smoke:full": "node scripts/smoke-consumer.mjs --vite",
    "gallery": "pnpm build && pnpm --filter @bit-ds/gallery dev",
    "dev": "pnpm gallery",
    "gallery:build": "pnpm build && pnpm --filter @bit-ds/gallery build",
    "preview": "pnpm gallery:build && pnpm --filter @bit-ds/gallery preview",
    "e2e": "pnpm --filter @bit-ds/gallery e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2"
    },
    "onlyBuiltDependencies": []
  }
}
