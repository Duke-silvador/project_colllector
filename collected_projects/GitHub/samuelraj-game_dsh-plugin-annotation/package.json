{
  "name": "dsh-plugin-annotation",
  "version": "0.3.1",
  "description": "Stage comments on selected passages in a DSH conversation and send them with your next message.",
  "license": "MIT",
  "author": "samuelraj-game <237381909+samuelraj-game@users.noreply.github.com>",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "annotation",
    "comment"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
