{
  "name": "pixel-shoot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser twin-stick shooter in pixel art.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage && npm run check:palette && npm run check:schemas && npm run validate:themes && npm run check:i18n",
    "check:palette": "tsx tools/src/palette-check/cli.ts",
    "validate:themes": "tsx tools/src/validate-themes/cli.ts",
    "schemas": "tsx tools/src/schemas/cli.ts",
    "check:schemas": "tsx tools/src/schemas/cli.ts --check",
    "assets:placeholders": "tsx tools/src/placeholders/cli.ts",
    "assets:report": "tsx tools/src/placeholders/cli.ts --report",
    "assets:font": "tsx tools/src/hud-font/cli.ts",
    "dev": "npm run dev -w @pixel-shoot/client",
    "build": "npm run build -w @pixel-shoot/client",
    "check:i18n": "tsx tools/src/check-i18n/cli.ts",
    "sprites:export": "tsx tools/src/sprites-export/cli.ts",
    "bench:sim": "tsx tools/src/bench/cli.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
