{
  "extends": "./tsconfig/base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.tsx",
    "apps/client/vite/**/*.ts",
    "tools/src/**/*.test.ts",
    "vitest.config.ts",
    "tools/src/**/*.d.ts",
    "apps/client/e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
