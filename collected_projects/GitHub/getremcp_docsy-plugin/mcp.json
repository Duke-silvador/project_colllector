{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "docsy": {
      "type": "streamable-http",
      "url": "https://docsy.remcp.site/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://docsy.remcp.site/oauth/register",
            "resource": "https://docsy.remcp.site/mcp",
            "baseScopes": [
              "docsy:read"
            ],
            "defaultScopes": [
              "docsy:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
