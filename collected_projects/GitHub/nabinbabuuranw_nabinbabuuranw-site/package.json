{
  "name": "nabinbabuuranw-site",
  "private": true,
  "version": "1.0.0",
  "description": "Nabin Babu Uranw: website development services and project requests. Next.js + TypeScript + Tailwind + Prisma/PostgreSQL + Clerk + Zod.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "github:snapshot": "tsx scripts/github-snapshot.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.0",
    "@prisma/client": "^6.16.0",
    "next": "^15.5.7",
    "prisma": "^6.16.0",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "server-only": "^0.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2"
  }
}