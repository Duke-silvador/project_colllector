{
    "name": "netarz/netarz-ai-whmcs",
    "description": "AI live chat and AI ticket replies for WHMCS, powered by the NetArz AI API. Shows your NetArz AI credit inside WHMCS.",
    "type": "whmcs-addon",
    "license": "MIT",
    "homepage": "https://netarz.ir/ai-api",
    "keywords": ["whmcs", "whmcs-addon", "whmcs-module", "ai", "chatbot", "live-chat", "support-tickets", "openai", "persian"],
    "authors": [{ "name": "NetArz", "email": "dev@netarz.ir", "homepage": "https://netarz.ir" }],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "illuminate/database": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": { "NetArz\\WhmcsAi\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --exclude-group live",
        "test:live": "phpunit --group live"
    },
    "config": { "sort-packages": true }
}
