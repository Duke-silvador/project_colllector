{
  "name": "tunely",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @tunely/db generate",
    "db:migrate": "pnpm --filter @tunely/db migrate",
    "stats": "pnpm --filter @tunely/worker stats"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
