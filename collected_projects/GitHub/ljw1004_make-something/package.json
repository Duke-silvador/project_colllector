{
  "name": "make-something",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "node src/lint/cli.ts",
    "test": "node --test tests/*.test.ts && playwright test",
    "build": "npm run check && vite build",
    "play": "node src/playtest/cli.ts",
    "playtest": "node src/playtest/run-ai.ts",
    "evaluate": "node src/playtest/evaluate-cli.ts",
    "analyze": "node src/analysis/cli.ts",
    "checkpoint": "node src/debug/cli.ts",
    "browser-test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  }
}
