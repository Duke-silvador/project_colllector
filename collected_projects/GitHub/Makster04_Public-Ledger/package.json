{
  "name": "public-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.dev.vars scripts/local.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "seed:export": "node --env-file-if-exists=.dev.vars scripts/export-seed.mjs",
    "scores:monthly": "node scripts/scores-monthly.mjs",
    "integrity:monthly": "node scripts/integrity-preview-monthly.mjs",
    "social:bluesky": "node scripts/find-bluesky.mjs",
    "senate:build": "node scripts/build-senate.mjs",
    "house:build": "node scripts/build-house.mjs",
    "house:elect": "node scripts/build-members-elect.mjs",
    "exec:build": "node scripts/build-exec-trades.mjs",
    "votes:party": "node scripts/build-vote-party.mjs",
    "attendance:build": "node scripts/build-attendance.mjs",
    "getitdone:build": "node --env-file-if-exists=.dev.vars scripts/build-get-it-done.mjs",
    "votes:positions": "node scripts/fill-vote-positions.mjs",
    "bills:cosponsors": "node --env-file-if-exists=.dev.vars scripts/fill-bill-cosponsors.mjs",
    "pacs:types": "node --env-file-if-exists=.dev.vars scripts/build-pac-types.mjs",
    "corporate:pacs": "node --env-file-if-exists=.dev.vars scripts/build-corporate-pacs.mjs",
    "funders:bundled": "node --env-file-if-exists=.dev.vars scripts/build-bundled.mjs",
    "review:money": "node scripts/review-money.mjs",
    "review:pledges": "node scripts/review-pledges.mjs",
    "promises:find": "node --env-file-if-exists=.dev.vars --no-warnings=ExperimentalWarning scripts/find-promises.mjs",
    "promises:review": "node scripts/review-promises.mjs",
    "ratings:collect": "node --no-warnings=ExperimentalWarning scripts/collect-ratings.mjs",
    "ratings:probe": "node --no-warnings=ExperimentalWarning scripts/ratings-probe.mjs",
    "ratings:browse": "node --no-warnings=ExperimentalWarning scripts/ratings-browse.mjs",
    "campaign:collect": "node --env-file-if-exists=.dev.vars --no-warnings=ExperimentalWarning scripts/collect-campaign-text.mjs",
    "review:holdings": "node --no-warnings=ExperimentalWarning scripts/review-holdings.mjs",
    "money:update": "node --env-file-if-exists=.dev.vars scripts/update-campaign-money.mjs",
    "counties:update": "node scripts/county-results.mjs",
    "maps:build": "node scripts/build-maps.mjs",
    "portraits:fetch": "node scripts/fetch-portrait-photos.mjs",
    "efd:fetch": "node --no-warnings=ExperimentalWarning scripts/efd-browser.mjs",
    "efd:import": "node --no-warnings=ExperimentalWarning scripts/import-efd.mjs",
    "check:sources": "node --env-file-if-exists=.dev.vars --no-warnings=ExperimentalWarning scripts/check-sources.mjs",
    "cloudflare:preview": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply public-ledger --remote",
    "consistency:prepare": "node --env-file-if-exists=.dev.vars scripts/consistency.mjs prepare",
    "consistency:run": "node --env-file-if-exists=.dev.vars scripts/consistency.mjs run",
    "consistency:export": "node --env-file-if-exists=.dev.vars scripts/consistency.mjs export",
    "consistency:status": "node --env-file-if-exists=.dev.vars scripts/consistency.mjs status",
    "consistency:evaluate": "python3 scripts/consistency/evaluate.py",
    "test:consistency": "python3 -m unittest discover -s test/consistency -v",
    "bills:index": "node scripts/build-bill-index.mjs",
    "bills:candidates": "node scripts/question-bills.mjs",
    "bills:record": "node scripts/build-question-record.mjs && node scripts/build-promises.mjs",
    "statements:find": "node scripts/question-statements.mjs --find",
    "statements:record": "node scripts/question-statements.mjs && node scripts/build-promises.mjs",
    "promises:build": "node scripts/build-promises.mjs",
    "statements:export": "node --env-file-if-exists=.dev.vars --no-warnings=ExperimentalWarning scripts/export-statements.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.28.2",
    "wrangler": "^4.0.0"
  }
}
