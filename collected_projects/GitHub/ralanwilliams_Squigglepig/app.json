{
  "expo": {
    "name": "Squigglepig",
    "slug": "squigglepig",
    "version": "2.2.0",
    "orientation": "default",
    "scheme": "squigglepig",
    "icon": "./src/assets/images/logo-512X512.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#4ECDC4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squigglepig.app"
    },
    "android": {
      "package": "com.squigglepig.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4ECDC4",
        "foregroundImage": "./src/assets/images/logo-512X512.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "squigglepig.app", "pathPrefix": "/join" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/images/logo-192X192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo-512X512.png",
          "resizeMode": "contain",
          "backgroundColor": "#4ECDC4",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9768dd83-627d-4a09-8aa3-809cce81beb5"
      }
    }
  }
}
