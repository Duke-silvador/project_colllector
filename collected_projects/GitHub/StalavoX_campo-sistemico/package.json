{
  "name": "campo-sistemico",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run assets:twemoji && vite --host 0.0.0.0",
    "build": "npm run assets:twemoji && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:twemoji": "node scripts/copy-twemoji.mjs",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "pinia": "^4.1.0",
    "twemoji": "^14.0.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
