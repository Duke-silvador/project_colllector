{
  "name": "schoolink",
  "version": "1.0.0",
  "private": true,
  "description": "Schoolink - campus chat on Cloudflare Workers (D1 + KV + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute schoolink-db --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute schoolink-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
