{
  "name": "snack-sprout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original mobile-first dental health arcade game built with Phaser 4.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "test:offline": "playwright test --config playwright.production.config.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
