{
  "name": "airlock-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @airlock/web dev",
    "dev:web": "pnpm --filter @airlock/web dev",
    "dev:gateway": "pnpm --filter @airlock/gateway dev",
    "start:gateway": "pnpm --filter @airlock/gateway start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "bench": "pnpm --filter @airlock/bench run bench",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "veeshree": "^1.0.0-rc.1"
  }
}
