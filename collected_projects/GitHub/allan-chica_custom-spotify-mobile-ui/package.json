{
  "name": "spotify-mobile-test",
  "version": "1.0.0",
  "description": "Personal Chrome/Chromium WebExtension that injects a mobile-friendly player UI\r on top of the desktop Spotify Web Player (`https://open.spotify.com`).",
  "main": "content.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "serve": "node tests/serve.js",
    "test": "npm run test:curation && npm run test:tippy && npm run test:stale && npm run test:lazy && npm run test:sheet && npm run test:fallback && npm run test:ui && npm run test:flaky && npm run test:lyrics && npm run test:lyrics-inline && npm run test:lyrics-warmup && npm run test:lyrics-divergence && npm run test:lyrics-switch && npm run test:coverlyrics && npm run test:transfer && npm run test:volume && npm run test:context",
    "test:curation": "node tests/cdp-run.js tests/real-dom-curation.html",
    "test:tippy": "node tests/cdp-run.js tests/real-dom-tippy.html",
    "test:stale": "node tests/cdp-run.js tests/real-dom-stale-popper.html",
    "test:lazy": "node tests/cdp-run.js tests/real-dom-lazy-popper.html",
    "test:fallback": "node tests/cdp-probe.js tests/harness.html tests/probe-fallback.js 4000",
    "test:sheet": "node tests/cdp-probe.js tests/harness.html tests/probe-sheet.js 4000",
    "test:ui": "node tests/cdp-probe.js tests/harness.html tests/probe-ui.js 4000",
    "test:flaky": "node tests/cdp-probe.js tests/harness.html tests/probe-flaky.js 4000",
    "test:lyrics": "node tests/cdp-probe.js tests/harness.html tests/probe-lyrics.js 4000",
    "test:lyrics-inline": "node tests/cdp-probe.js tests/harness.html tests/probe-lyrics-inline.js 4000",
    "test:lyrics-warmup": "node tests/cdp-probe.js tests/harness.html tests/probe-lyrics-warmup.js 4000",
    "test:lyrics-divergence": "node tests/cdp-probe.js tests/harness.html tests/probe-lyrics-divergence.js 4000",
    "test:lyrics-switch": "node tests/cdp-probe.js tests/harness.html tests/probe-lyrics-switch.js 4000",
    "test:coverlyrics": "node tests/cdp-probe.js tests/harness.html tests/probe-coverlyrics.js 4000",
    "test:transfer": "node tests/cdp-probe.js tests/harness.html tests/probe-transfer.js 4000",
    "test:volume": "node tests/cdp-probe.js tests/harness.html tests/probe-volume.js 4000",
    "test:context": "node tests/cdp-probe.js tests/harness.html tests/probe-context.js 4000",
    "test:context": "node tests/cdp-probe.js tests/harness.html tests/probe-context.js 4000",
    "diagnose": "node -e \"console.log('Open tests/diagnose-playlists.html, then paste tests/diagnose-playlists.js into the Spotify tab console.')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
