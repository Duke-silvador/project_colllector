{
  "name": "novi",
  "private": true,
  "description": "NOVI: metadata-driven React frontend for an unmodified Odoo 20 backend",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "bash scripts/dev.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "progress": "node tools/progress-dashboard/build.mjs --out dist/progress",
    "odoo:build": "bash infra/images/odoo20/build.sh",
    "odoo:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "odoo:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "odoo:reset": "bash infra/compose/reset-dev.sh",
    "odoo:seed": "bash infra/compose/seed-dev.sh",
    "odoo:shell": "docker compose -f infra/compose/docker-compose.dev.yml exec odoo python3 /opt/odoo/setup/odoo shell --config=/etc/odoo/odoo.conf -d novi_demo --no-http",
    "odoo:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f odoo",
    "test:contract": "pnpm --filter @novi/contract-tests test",
    "scan": "pnpm --filter @novi/coverage-scanner scan",
    "changeset": "changeset",
    "prepare": "husky",
    "verify": "bash scripts/verify-local.sh",
    "serve": "bash scripts/serve.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
