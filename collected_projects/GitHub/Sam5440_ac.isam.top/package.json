{
  "name": "ac-isam-top",
  "version": "1.0.0",
  "private": true,
  "description": "AC 题库 —— AtCoder (ABC) 与 Codeforces 比赛题目的抓取、AI 中文翻译与网页展示",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-index.mjs && next build",
    "start": "next start",
    "fetch": "node scripts/fetch.mjs",
    "fetch:init": "node scripts/fetch.mjs --abc 10 --cf 10 --backfill 0",
    "fetch:ci": "node scripts/fetch.mjs --abc 3 --cf 3 --backfill 10 --translate-limit 120",
    "translate": "node scripts/fetch.mjs --translate-only",
    "index": "node scripts/build-index.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "lucide-react": "^1.50.0",
    "marked": "^15.0.12",
    "next": "^15.5.4",
    "playwright": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
