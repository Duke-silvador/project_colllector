{
  "name": "lantube",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=config/development.env --watch --import remix/node-tsx server.ts",
    "hmr": "node --env-file=config/development.env hmr.ts",
    "start": "node --env-file=config/production.env --import remix/node-tsx server.ts",
    "test": "node --env-file=config/test.env node_modules/remix/dist/cli-entry.js test",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "typescript": "latest"
  }
}
