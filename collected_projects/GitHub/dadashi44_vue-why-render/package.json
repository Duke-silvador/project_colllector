{
    "name": "vue-why-render",
    "version": "0.3.0",
    "type": "module",
    "description": "See which Vue components re-render — and why. Highlights re-renders and names the exact reactive dependency that triggered them.",
    "keywords": [
        "vue",
        "vue3",
        "devtools",
        "performance",
        "rerender",
        "render",
        "profiler",
        "scan",
        "debug",
        "nuxt",
        "nuxt-module",
        "testing",
        "vitest"
    ],
    "license": "MIT",
    "author": "dadashi44",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dadashi44/vue-why-render.git"
    },
    "bugs": "https://github.com/dadashi44/vue-why-render/issues",
    "homepage": "https://github.com/dadashi44/vue-why-render#readme",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.mjs"
        },
        "./test": {
            "types": "./dist/test.d.ts",
            "import": "./dist/test.js",
            "require": "./dist/test.cjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite --config playground/vite.config.ts",
        "dev:site": "vite --config site/vite.config.ts",
        "build:site": "vite build --config site/vite.config.ts",
        "build": "vite build && node scripts/ascii-bundle.mjs && node scripts/build-nuxt.mjs && node scripts/build-test.mjs && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@nuxt/kit": "^3.0.0 || ^4.0.0",
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@nuxt/kit": "^4.5.2",
        "@nuxt/schema": "^4.5.2",
        "@types/node": "^22.10.2",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitest/coverage-v8": "^3.2.7",
        "@vue/test-utils": "^2.4.6",
        "esbuild": "^0.25.0",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^25.0.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.1",
        "vite": "^6.0.5",
        "vitest": "^3.2.7",
        "vue": "^3.5.13",
        "vue-eslint-parser": "^9.4.3",
        "vue-tsc": "^2.2.0"
    },
    "peerDependenciesMeta": {
        "@nuxt/kit": {
            "optional": true
        }
    }
}
