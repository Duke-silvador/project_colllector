{
  "name": "legendenweg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p .",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
