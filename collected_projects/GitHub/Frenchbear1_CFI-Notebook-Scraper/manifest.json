{
  "manifest_version": 3,
  "name": "Links to One PDF",
  "version": "2.2.0",
  "description": "Pick the links you want on a page (as many levels deep as you like), and it saves every page as a PDF and merges them into one.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Links to One PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
