{
  "name": "drizzlet-hygrostat",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:html": "htmlhint \"static/**/*.html\"",
    "lint:css": "stylelint \"static/**/*.{css,html}\" --max-warnings=0",
    "lint:controls": "node test/lint.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "postcss": "8.5.32",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
