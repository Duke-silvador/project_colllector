{
  "name": "kb-articles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notion 同步文章库 → GitHub → VitePress → Cloudflare Workers 静态站",
  "scripts": {
    "prep": "node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs && vitepress dev docs --host 127.0.0.1",
    "build": "node scripts/build-site.mjs && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "wrangler": "^4.148.0"
  }
}
