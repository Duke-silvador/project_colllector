{
  "name": "@micelio/strapi-plugin-fediverse",
  "version": "0.1.0",
  "description": "Micelio's fediverse federation (ActivityPub) as a Strapi 5 plugin.",
  "private": true,
  "type": "commonjs",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogd3v/micelio-plugin-fediverse.git"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "micelio",
    "fediverse",
    "activitypub"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "micelio": "0.7",
  "strapi": {
    "kind": "plugin",
    "name": "fediverse",
    "displayName": "Fediverse",
    "description": "ActivityPub federation for Micelio CMS"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": "./dist/strapi-server.js"
  },
  "files": [
    "dist",
    "THIRD-PARTY.md",
    "LICENSES"
  ],
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "esbuild server/src/index.ts --bundle --packages=external --platform=node --format=cjs --outfile=dist/strapi-server.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p admin/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:standard": "micelio-lint-standard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run lint:licenses && npm run lint:standard"
  },
  "dependencies": {
    "@fedify/fedify": "2.4.4",
    "@fedify/koa": "2.4.4",
    "@fedify/postgres": "2.4.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@logtape/logtape": "^2.4.1",
    "postgres": "3.4.9",
    "structured-field-values": "2.0.4"
  },
  "peerDependencies": {
    "@micelio/strapi-plugin-core": "^0.2.0",
    "@strapi/strapi": "^5.59.0",
    "strapi-plugin-comments": "^3.2.4"
  },
  "devDependencies": {
    "@micelio/eslint-config": "^0.2.8",
    "@micelio/prettier-config": "^0.1.0",
    "@micelio/strapi-plugin-core": "0.2.0",
    "@micelio/tsconfig": "^0.1.0",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/plugin-users-permissions": "5.59.0",
    "@strapi/strapi": "5.59.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "12.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.3",
    "strapi-plugin-comments": "3.2.4",
    "styled-components": "^6.6.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@micelio/prettier-config"
}
