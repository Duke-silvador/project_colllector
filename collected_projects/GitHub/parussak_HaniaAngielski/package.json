{
  "name": "hania-language-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:content && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "firebase": "^13.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
