{
  "name": "calcbridge",
  "version": "0.5.0",
  "private": true,
  "description": "樂創 LeChuang（calcbridge）— 面板式工程计算器：核心计算内核 + Web 界面",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "regression": "tsx packages/cli/src/index.ts regression",
    "demo": "tsx packages/cli/src/index.ts demo",
    "validate:impedance": "tsx packages/cli/src/index.ts validate-impedance validation/impedance/golden.json",
    "validate:impedance:strict": "tsx packages/cli/src/index.ts validate-impedance validation/impedance/golden.json --require-polar-sigrity",
    "dev": "npm run dev -w @calcbridge/web",
    "build:web": "npm run build -w @calcbridge/web",
    "build:offline": "node scripts/build-offline.mjs",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
