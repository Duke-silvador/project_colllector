{
  "name": "dsh-ghg",
  "version": "0.1.0-alpha.14",
  "description": "Electricity activity ingest, location-based GHG calculation, row verification, workpaper and partial ESRS pack.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate:sku02": "node scripts/gate-sku02.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs",
    "pack:check": "npm pack --dry-run --json > pack.json && node scripts/check-pack.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ghg",
    "esg",
    "electricity",
    "perrylink",
    "esrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-ghg.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.394",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-ghg.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-ghg/issues"
  },
  "icon": "icon.svg"
}
