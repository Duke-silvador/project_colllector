{
  "name": "spectre",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fsd": "pnpm --filter @spectre/web lint:fsd",
    "dev:api": "pnpm --filter @spectre/api dev",
    "dev:web": "pnpm --filter @spectre/web dev",
    "bootstrap:dev": "pnpm --filter @spectre/api bootstrap:dev"
  }
}
