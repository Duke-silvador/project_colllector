{
  "expo": {
    "name": "Connected Access",
    "slug": "connected-access-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./static/images/escola-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "appleId": "your-apple-id",
      "supportsTablet": true,
      "bundleIdentifier": "com.connected.access",
      "buildNumber": "1.0.0",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permitir o uso do FaceID para acesso r\u00e1pido.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "statusBar": {
      "backgroundColor": "#2563EB",
      "style": "light",
      "hidden": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./static/images/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "your-organization"
  }
}