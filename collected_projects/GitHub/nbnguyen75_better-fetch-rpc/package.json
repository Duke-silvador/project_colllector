{
  "name": "better-fetch-rpc",
  "version": "0.1.0",
  "description": "Type-safe RPC-style client built on @better-fetch/fetch — define routes once, call them like local functions.",
  "keywords": [
    "better-fetch",
    "fetch",
    "rpc",
    "typed-client",
    "typescript"
  ],
  "homepage": "https://github.com/nbnguyen75/better-fetch-rpc#readme",
  "bugs": {
    "url": "https://github.com/nbnguyen75/better-fetch-rpc/issues"
  },
  "license": "MIT",
  "author": "Nguyên (Wynn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbnguyen75/better-fetch-rpc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@better-fetch/fetch": "^1.3.2",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "valibot": "^1.1.0",
    "vitest": "^3.2.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@better-fetch/fetch": "^1.1.21"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
