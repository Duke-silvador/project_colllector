{
  "name": "@orix/cli",
  "version": "0.5.0",
  "description": "ORIX — Open Research & Intelligence eXplorer: local-first artifact and repository intelligence",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "orix": "./src/cli.mjs",
    "orix-mcp": "./src/mcp.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./formats/pe": "./src/formats/pe.mjs",
    "./formats/elf": "./src/formats/elf.mjs",
    "./project": "./src/project/intelligence.mjs",
    "./formats/pdf": "./src/formats/pdf.mjs",
    "./formats/wasm": "./src/formats/wasm.mjs",
    "./reports/sarif": "./src/reports/sarif.mjs",
    "./evidence/ledger": "./src/evidence/ledger.mjs",
    "./analyzer/compare": "./src/analyzer/compare.mjs",
    "./reports/comparison": "./src/reports/comparison.mjs",
    "./mcp": "./src/mcp/server.mjs",
    "./reports/cyclonedx": "./src/reports/cyclonedx.mjs",
    "./core/evidence-ledger": "./src/core/evidence-ledger.mjs",
    "./project/lockfiles": "./src/project/lockfiles.mjs",
    "./project/git-metadata": "./src/project/git-metadata.mjs",
    "./providers/manifest": "./src/providers/manifest.mjs",
    "./providers/registry": "./src/providers/registry.mjs",
    "./providers/process-runner": "./src/providers/process-runner.mjs",
    "./providers/rizin": "./src/providers/rizin.mjs",
    "./reports/view-model": "./src/reports/view-model.mjs",
    "./reports/rizin": "./src/reports/rizin.mjs",
    "./project/architecture": "./src/project/architecture.mjs",
    "./reports/architecture": "./src/reports/architecture.mjs",
    "./vulnerability/osv": "./src/vulnerability/osv.mjs",
    "./formats/png": "./src/formats/png.mjs",
    "./capabilities": "./src/capabilities/registry.mjs",
    "./network/har": "./src/network/har.mjs"
  },
  "scripts": {
    "start": "node ./src/cli.mjs",
    "orix": "node ./src/cli.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-docs.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "mcp": "node ./src/mcp.mjs",
    "web": "node ./scripts/serve-web.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "license": "Apache-2.0"
}
