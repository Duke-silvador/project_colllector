{
  "name": "DriveACarForAnime",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": { "$path": "src/ReplicatedStorage/Shared" }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Main": { "$path": "src/ServerScriptService/Main.server.luau" },
      "Services": { "$path": "src/ServerScriptService/Services" }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "ClientMain": { "$path": "src/StarterPlayer/StarterPlayerScripts/ClientMain.client.luau" },
        "Client": { "$path": "src/StarterPlayer/StarterPlayerScripts/Client" }
      }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "ProjectDocs": { "$path": "src/ServerStorage/ProjectDocs" },
      "Tools": { "$path": "src/ServerStorage/Tools" },
      "LegacyCode": { "$path": "src/ServerStorage/LegacyCode" }
    }
  }
}
