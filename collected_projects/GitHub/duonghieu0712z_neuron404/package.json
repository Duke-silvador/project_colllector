{
    "name": "neuron404",
    "version": "0.1.0-beta.2",
    "private": true,
    "license": "MIT",
    "author": "duonghieu0712z",
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "build": "run-p type-check \"build-only {@}\" --",
        "build:headless": "run-s build:headless-runtime package:headless",
        "build:headless-runtime": "vite build --config vite.headless.config.ts",
        "build:runtime": "vite build --config vite.runtime.config.ts",
        "build:web": "vite build",
        "build-only": "run-s \"build:web {@}\" build:runtime --",
        "bump": "node scripts/bump-version.mjs",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "db:generate": "drizzle-kit generate",
        "db:index": "node --import tsx scripts/index-neurons.ts",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "dev": "vite dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint . --cache",
        "lint:fix": "eslint --fix . --cache",
        "maintenance": "node --import tsx scripts/maintenance.ts",
        "neuron": "node --import tsx scripts/neuron.ts",
        "neuron:add": "node --import tsx scripts/add-neuron.ts",
        "neuron:lint": "node --import tsx scripts/lint-neurons.ts",
        "neuron:search": "node --import tsx scripts/search-neurons.ts",
        "package:headless": "node scripts/package-headless.mjs",
        "package:promote": "node scripts/package-release.ts promote",
        "package:release": "node scripts/package-release.ts pack",
        "package:verify": "node scripts/package-release.ts verify",
        "prepare": "svelte-kit sync || echo '' && husky",
        "preview": "vite preview",
        "release:check": "node scripts/release-notes.mjs",
        "type-check": "pnpm check"
    },
    "dependencies": {
        "@11ty/gray-matter": "3.0.0",
        "@libsql/client": "^0.18.0",
        "drizzle-orm": "^0.45.4",
        "marked": "^18.1.3",
        "sanitize-html": "^2.18.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.68.0",
        "@sveltejs/adapter-node": "^6.0.1",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "@types/d3-force": "3.0.10",
        "@types/node": "^26.6.6",
        "@types/sanitize-html": "^2.16.2",
        "bits-ui": "^2.20.4",
        "cn": "^0.5.2",
        "d3-force": "3.0.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-svelte": "^3.24.0",
        "globals": "^17.14.0",
        "graphology": "^0.26.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "mode-watcher": "1.1.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.1.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn-svelte": "^1.8.0",
        "sigma": "^4.0.4",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.4",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=24"
    }
}
