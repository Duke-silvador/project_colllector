{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "strict": true,
        "types": ["$app/types", "node"],
        "paths": {
            "#lib": ["./src/lib/index.ts"],
            "#lib/*": ["./src/lib/*"]
        }
    },
    "include": [
        "src",
        "scripts",
        "vite.config.ts",
        "vite.runtime.config.ts",
        "vite.headless.config.ts",
        "prettier.config.ts",
        "eslint.config.ts",
        "drizzle.config.ts",
        "commitlint.config.ts",
        "lint-staged.config.js"
    ]
}
