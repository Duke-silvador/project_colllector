{
  "name": "imovies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix server",
    "dev:full": "concurrently -k -n API,WEB \"npm run dev:api\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "npm run seed --prefix server"
  },
  "dependencies": { "react": "latest", "react-dom": "latest", "vite": "latest", "socket.io-client": "latest" },
  "devDependencies": { "concurrently": "latest" }
}
