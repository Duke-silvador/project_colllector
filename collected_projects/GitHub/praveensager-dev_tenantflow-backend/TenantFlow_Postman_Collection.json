{
  "info": {
    "name": "TenantFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000"},
    {"key": "token", "value": "PASTE_TOKEN_HERE"},
    {"key": "tenant_id", "value": "1"}
  ],
  "item": [
    {
      "name": "Get Token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
        "body": {"mode": "urlencoded", "urlencoded": [
          {"key": "username", "value": "owner"},
          {"key": "password", "value": "pass12345"}
        ]},
        "url": {"raw": "{{base_url}}/api/auth/token/", "host": ["{{base_url}}"], "path": ["api","auth","token"]}
      }
    },
    {
      "name": "List My Tenants",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Token {{token}}"}],
        "url": {"raw": "{{base_url}}/api/tenants/", "host": ["{{base_url}}"], "path": ["api","tenants"]}
      }
    },
    {
      "name": "Create Tenant",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Token {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{"name":"Acme Corp","slug":"acme-corp"}"},
        "url": {"raw": "{{base_url}}/api/tenants/", "host": ["{{base_url}}"], "path": ["api","tenants"]}
      }
    },
    {
      "name": "Record Usage",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Token {{token}}"},
          {"key": "X-Tenant-ID", "value": "{{tenant_id}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{"day":"2026-09-02","endpoint":"/api/orders/","units":25}"},
        "url": {"raw": "{{base_url}}/api/usage/", "host": ["{{base_url}}"], "path": ["api","usage"]}
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Token {{token}}"},
          {"key": "X-Tenant-ID", "value": "{{tenant_id}}"}
        ],
        "url": {"raw": "{{base_url}}/api/dashboard/", "host": ["{{base_url}}"], "path": ["api","dashboard"]}
      }
    },
    {
      "name": "Generate Current Invoice",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Token {{token}}"},
          {"key": "X-Tenant-ID", "value": "{{tenant_id}}"}
        ],
        "url": {"raw": "{{base_url}}/api/invoices/generate_current/", "host": ["{{base_url}}"], "path": ["api","invoices","generate_current"]}
      }
    }
  ]
}
