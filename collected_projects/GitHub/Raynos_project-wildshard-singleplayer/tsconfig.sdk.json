{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "outDir": ".tsc-layers/sdk",
    "tsBuildInfoFile": ".tsc-layers/sdk.tsbuildinfo"
  },
  "references": [
    { "path": "./tsconfig.format.json" },
    {
      "path": "./tsconfig.engine.json"
    },
    {
      "path": "./tsconfig.game.json"
    }
  ],
  "include": [
    "src/sdk/**/*.ts",
    "src/sdk/**/*.mts",
    "src/engine/**/*.d.ts",
    "src/game/**/*.merge.d.ts"
  ],
  "exclude": ["src/sdk/**/*.test.ts", "src/sdk/test"]
}
