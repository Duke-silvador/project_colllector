{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": [],
    "lib": [
      "ES2022"
    ],
    "outDir": ".tsc-layers/format",
    "tsBuildInfoFile": ".tsc-layers/format.tsbuildinfo"
  },
  "include": [
    "src/format/**/*.ts",
    "src/format/memoryGates.json",
    "types/format-standards.d.ts"
  ],
  "exclude": ["src/format/**/*.test.ts"]
}
