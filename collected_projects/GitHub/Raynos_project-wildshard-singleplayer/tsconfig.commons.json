{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "outDir": ".tsc-layers/commons",
    "tsBuildInfoFile": ".tsc-layers/commons.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.sdk.json" }],
  "include": ["src/commons/**/*.ts", "src/commons/**/*.json", "src/engine/**/*.d.ts", "src/game/**/*.merge.d.ts"],
  "exclude": ["src/commons/**/*.test.ts"]
}
