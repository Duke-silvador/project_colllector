{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "outDir": ".tsc-layers/game",
    "tsBuildInfoFile": ".tsc-layers/game.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.engine.json" }, { "path": "./tsconfig.format.json" }],
  // T1: generated JSON has no compiler roots; authored JSON remains fully typed.
  "files": [],
  "include": ["src/game", "src/game/**/*.json", "src/engine/**/*.d.ts"],
  "exclude": ["src/game/**/*.test.ts", "src/game/test", "src/game/**/*.generated.json"]
}
