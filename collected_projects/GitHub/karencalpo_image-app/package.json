{
  "name": "image-app",
  "version": "1.0.0",
  "private": true,
  "description": "React, Material UI and TypeScript with an Express service.",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": ">=12"
  },
  "scripts": {
    "start": "node dist/service/index.js",
    "start:dev": "webpack serve --mode development",
    "dev:server": "node --watch service/index.ts",
    "dev": "webpack --mode development",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit && webpack --mode production",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const dir of ['public', 'dist']) rmSync(dir, { recursive: true, force: true });\"",
    "reinstall": "npm ci",
    "rebuild": "npm run clean && npm ci && npm run build"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "favicons-webpack-plugin": "^6.0.1",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
