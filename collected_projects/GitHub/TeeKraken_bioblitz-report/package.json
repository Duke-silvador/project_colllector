{
  "name": "bioblitz-report",
  "private": true,
  "version": "1.0.0",
  "description": "Turn a bioblitz's iNaturalist sightings export into a tidy, printable nature report for the landowner, right in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
