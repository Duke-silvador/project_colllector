{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "antes-de-pagar",
  "version": "0.1.0",
  "description": "Analiza posibles estafas antes de enviar dinero, datos o credenciales.",
  "author": {
    "name": "Jose Dev",
    "url": "https://github.com/hose909012-coder"
  },
  "homepage": "https://github.com/hose909012-coder/antes-de-pagar#readme",
  "repository": "https://github.com/hose909012-coder/antes-de-pagar",
  "license": "MIT",
  "keywords": ["scam", "fraud", "phishing", "safety", "spanish"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Antes de Pagar",
        "shortDescription": "Revisa señales de estafa antes de actuar.",
        "longDescription": "Analiza capturas, mensajes, enlaces, ofertas, facturas y solicitudes de pago; explica las señales de riesgo y propone pasos seguros de verificación.",
        "developerName": "Jose Dev",
        "category": "Productivity",
        "capabilities": ["Analysis", "Web Research", "Image Understanding"],
        "websiteURL": "https://github.com/hose909012-coder/antes-de-pagar",
        "privacyPolicyURL": "https://github.com/hose909012-coder/antes-de-pagar/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/hose909012-coder/antes-de-pagar/blob/main/TERMS.md",
        "defaultPrompt": [
          "Analiza esta captura antes de que envíe dinero.",
          "¿Este mensaje parece una estafa?",
          "Revisa esta oferta y dime cómo verificarla."
        ],
        "brandColor": "#F59E0B"
      }
    }
  }
}
